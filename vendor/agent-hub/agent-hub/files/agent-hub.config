config agent_hub 'main'
	option enabled '0'
	option engine 'picoclaw'
	option managed_config '1'
	option provider 'openai_compatible'
	option api_base ''
	option api_key ''
	option model ''
	option temperature ''
	option max_tokens ''
	option listen_scope 'loopback'
	option port '18790'
	option picoclaw_web_ui '0'
	option picoclaw_web_scope 'lan'
	option picoclaw_web_port '18800'
	option telegram_enabled '0'
	option telegram_bot_token ''
	option telegram_group_mention_only '1'
	option telegram_proxy ''
	option respawn '1'
