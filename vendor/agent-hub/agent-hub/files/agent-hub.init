#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

CONFIG='agent-hub'
PROG_GENERATE='/usr/libexec/agent-hub-generate'
STATE_ROOT='/etc/agent-hub'
MANAGED_ROOT="$STATE_ROOT/managed"
NATIVE_ROOT="$STATE_ROOT/native"

prepare_roots() {
	mkdir -p "$MANAGED_ROOT" "$NATIVE_ROOT" || return 1
	chown root:agenthub "$STATE_ROOT" "$MANAGED_ROOT" "$NATIVE_ROOT" || return 1
	chmod 0710 "$STATE_ROOT" "$MANAGED_ROOT" "$NATIVE_ROOT"
}

prepare_home() {
	local home="$1"
	mkdir -p "$home"
	chown -R agenthub:agenthub "$home"
	chmod 0700 "$home"
}

start_service() {
	local enabled engine managed listen_scope port respawn root_access run_user run_group
	local host home config_file config_revision
	local web_ui web_scope web_port web_host
	config_load "$CONFIG"
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get engine main engine 'picoclaw'
	config_get_bool managed main managed_config 1
	config_get listen_scope main listen_scope 'loopback'
	config_get port main port '18790'
	config_get_bool respawn main respawn 1
	config_get_bool root_access main root_access 0
	config_get_bool web_ui main picoclaw_web_ui 0
	config_get web_scope main picoclaw_web_scope 'lan'
	config_get web_port main picoclaw_web_port '18800'

	case "$engine" in
		picoclaw|nullclaw|zeroclaw) ;;
		*) logger -t agent-hub "unsupported engine: $engine"; return 1 ;;
	esac
	case "$listen_scope" in
		loopback) host='127.0.0.1' ;;
		lan) host='0.0.0.0' ;;
		*) logger -t agent-hub "unsupported listen scope: $listen_scope"; return 1 ;;
	esac
	if [ "$root_access" -eq 1 ]; then
		run_user='root'
		run_group='root'
	else
		run_user='agenthub'
		run_group='agenthub'
	fi
	prepare_roots || {
		logger -t agent-hub 'failed to prepare runtime directories'
		return 1
	}

	if [ "$managed" -eq 1 ]; then
		home="$MANAGED_ROOT/$engine"
		"$PROG_GENERATE" "$engine" || return 1
		case "$engine" in
			picoclaw|nullclaw) config_file="$home/config.json" ;;
			zeroclaw) config_file="$home/config.toml" ;;
		esac
	else
		home="$NATIVE_ROOT/$engine"
		prepare_home "$home"
		case "$engine" in
			picoclaw|nullclaw) config_file="$home/config.json" ;;
			zeroclaw) config_file="$home/config.toml" ;;
		esac
		if [ ! -s "$config_file" ]; then
			logger -t agent-hub "native config is missing: $config_file"
			return 1
		fi
		chown agenthub:agenthub "$config_file"
		chmod 0600 "$config_file"
	fi
	config_revision="$(sha256sum "$config_file" 2>/dev/null)"
	config_revision="${config_revision%% *}"
	[ "${#config_revision}" -eq 64 ] || {
		logger -t agent-hub "cannot hash runtime config: $config_file"
		return 1
	}

	procd_open_instance "$engine"
	case "$engine" in
		picoclaw)
			procd_set_param command /usr/bin/picoclaw --no-color gateway --allow-empty --host "$host"
			procd_set_param env \
				"HOME=$home" \
				"PICOCLAW_HOME=$home" \
				"PICOCLAW_CONFIG=$home/config.json" \
				"PICOCLAW_GATEWAY_HOST=$host" \
				"PICOCLAW_GATEWAY_PORT=$port" \
				"AGENT_HUB_CONFIG_REVISION=$config_revision" \
				"AGENT_HUB_ROOT_ACCESS=$root_access"
			;;
		nullclaw)
			procd_set_param command /usr/bin/nullclaw gateway \
				--host "$host" --port "$port" --workspace "$home/workspace"
			procd_set_param env \
				"HOME=$home" \
				"NULLCLAW_HOME=$home" \
				"AGENT_HUB_CONFIG_REVISION=$config_revision" \
				"AGENT_HUB_ROOT_ACCESS=$root_access"
			;;
		zeroclaw)
			procd_set_param command /usr/bin/zeroclaw --config-dir "$home" daemon \
				--host "$host" --port "$port"
			procd_set_param env \
				"HOME=$home" \
				"ZEROCLAW_CONFIG_DIR=$home" \
				"AGENT_HUB_CONFIG_REVISION=$config_revision" \
				"AGENT_HUB_ROOT_ACCESS=$root_access"
			;;
	esac
	procd_set_param user "$run_user"
	procd_set_param group "$run_group"
	procd_set_param stdout 1
	procd_set_param stderr 1
	[ "$respawn" -eq 1 ] && procd_set_param respawn 3600 5 5
	procd_close_instance

	if [ "$engine" = 'picoclaw' ] && [ "$web_ui" -eq 1 ]; then
		case "$web_scope" in
			loopback) web_host='127.0.0.1' ;;
			lan) web_host='0.0.0.0' ;;
			*) logger -t agent-hub "unsupported PicoClaw WebUI scope: $web_scope"; return 1 ;;
		esac
		case "$web_port" in ''|*[!0-9]*) logger -t agent-hub 'PicoClaw WebUI port must be an integer'; return 1 ;; esac
		[ "$web_port" -ge 1 ] && [ "$web_port" -le 65535 ] || {
			logger -t agent-hub 'PicoClaw WebUI port must be between 1 and 65535'
			return 1
		}
		[ "$web_port" != "$port" ] || {
			logger -t agent-hub 'PicoClaw WebUI port must differ from the runtime port'
			return 1
		}
		[ -x /usr/bin/picoclaw-launcher ] || {
			logger -t agent-hub 'PicoClaw WebUI launcher is not installed'
			return 1
		}

		procd_open_instance picoclaw-web
		procd_set_param command /usr/libexec/agent-hub-picoclaw-web \
			"$web_host" "$web_port" "$port" "$home/config.json"
		procd_set_param env \
			"HOME=$home" \
			"PICOCLAW_HOME=$home" \
			"PICOCLAW_CONFIG=$home/config.json" \
			"PICOCLAW_BINARY=/usr/bin/picoclaw"
		procd_set_param user agenthub
		procd_set_param group agenthub
		procd_set_param stdout 1
		procd_set_param stderr 1
		[ "$respawn" -eq 1 ] && procd_set_param respawn 3600 5 5
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
