#!/bin/sh
set -e

: "${IPKG_INSTROOT:=}"
export IPKG_INSTROOT

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

CONF=cloudflare-tunnel-manager
INIT=/etc/init.d/cloudflare-tunnel-manager
PROG=/usr/bin/cloudflared
API_BASE=${CTM_API_BASE:-https://api.cloudflare.com/client/v4}
CURL_BIN=${CTM_CURL_BIN:-/usr/bin/curl}
SECRET_ROOT=/etc/cloudflare-tunnel-manager/secrets
ACCOUNT_SECRET_ROOT=$SECRET_ROOT/accounts
TUNNEL_SECRET_ROOT=$SECRET_ROOT/tunnels
RUNTIME_ROOT=/tmp/cloudflare-tunnel-manager
REQUEST_FILE=$RUNTIME_ROOT/request.json
LOCK_DIR=$RUNTIME_ROOT/request.lock
LOG_ROOT=/var/log/cloudflare-tunnel-manager
MANAGER_LOG=$LOG_ROOT/manager.log
TEMP_PREFIX=$RUNTIME_ROOT/job.$$
LOCK_HELD=0
REMOVE_REQUEST=0
API_SEQ=0
API_OUTPUT=
API_ERROR=
API_HTTP=

umask 077

cleanup() {
	rm -f "$TEMP_PREFIX".* 2>/dev/null || true
	[ "$REMOVE_REQUEST" -eq 0 ] || rm -f "$REQUEST_FILE"
	[ "$LOCK_HELD" -eq 0 ] || rmdir "$LOCK_DIR" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

prepare_dirs() {
	mkdir -p "$ACCOUNT_SECRET_ROOT" "$TUNNEL_SECRET_ROOT" "$RUNTIME_ROOT" "$LOG_ROOT"
	chmod 0700 "$SECRET_ROOT" "$ACCOUNT_SECRET_ROOT" "$TUNNEL_SECRET_ROOT" "$RUNTIME_ROOT"
	[ ! -f /etc/config/$CONF ] || chmod 0600 /etc/config/$CONF
}

trim_log() {
	local size temp
	[ -f "$MANAGER_LOG" ] || return 0
	size="$(wc -c < "$MANAGER_LOG" 2>/dev/null || printf '0')"
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	[ "$size" -le 524288 ] && return 0
	temp="$TEMP_PREFIX.log"
	tail -c 262144 "$MANAGER_LOG" > "$temp" 2>/dev/null || return 0
	mv -f "$temp" "$MANAGER_LOG"
}

log_event() {
	local level="$1" action="$2" message="$3" clean
	clean="$(printf '%s' "$message" | tr '\r\n' '  ' | cut -c 1-300)"
	trim_log
	printf '%s\t%s\t%s\t%s\n' "$(date -Iseconds 2>/dev/null || date)" \
		"$level" "$action" "$clean" >> "$MANAGER_LOG"
	logger -t cloudflare-tunnel-manager "[$level] $action: $clean"
}

fail() {
	local message="$*"
	log_event error request "$message"
	printf '%s\n' "$message" >&2
	exit 1
}

emit_message() {
	local message="$1"
	json_init
	json_add_boolean success 1
	json_add_string message "$message"
	json_dump
	printf '\n'
}

acquire_lock() {
	local attempt=0
	while ! mkdir "$LOCK_DIR" 2>/dev/null; do
		attempt=$((attempt + 1))
		[ "$attempt" -lt 50 ] || fail '另一个 Cloudflare Tunnel 操作仍在执行'
		usleep 100000 2>/dev/null || sleep 1
	done
	LOCK_HELD=1
}

request_value() {
	jsonfilter -i "$REQUEST_FILE" -e "@.$1" 2>/dev/null | head -n 1 || true
}

bool_value() {
	case "$1" in 1|true|yes|on) printf '1\n' ;; *) printf '0\n' ;; esac
}

safe_text() {
	local value="$1" max="$2" length
	[ -n "$value" ] || return 1
	! printf '%s' "$value" | grep -q '[[:cntrl:]]' || return 1
	length="$(printf '%s' "$value" | wc -c)"
	[ "$length" -le "$max" ]
}

valid_section() {
	case "$1" in ''|*[!A-Za-z0-9_]*) return 1 ;; *) return 0 ;; esac
}

valid_account_id() {
	printf '%s' "$1" | grep -Eq '^[0-9a-fA-F]{32}$'
}

valid_zone_id() {
	valid_account_id "$1"
}

valid_uuid() {
	printf '%s' "$1" | grep -Eq \
		'^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
}

valid_secret() {
	local value="$1" max="$2" length
	[ -n "$value" ] || return 1
	case "$value" in *[!A-Za-z0-9._=-]*) return 1 ;; esac
	length="$(printf '%s' "$value" | wc -c)"
	[ "$length" -le "$max" ]
}

valid_hostname() {
	local value="$1"
	[ "$(printf '%s' "$value" | wc -c)" -le 253 ] || return 1
	printf '%s' "$value" | grep -Eq \
		'^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'
}

valid_ipv4() (
	local octet
	set -f
	IFS=.
	set -- $1
	[ "$#" -eq 4 ] || exit 1
	for octet in "$@"; do
		case "$octet" in ''|*[!0-9]*) exit 1 ;; esac
		[ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] || exit 1
	done
)

valid_mac() {
	[ -z "$1" ] || printf '%s' "$1" | grep -Eqi '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'
}

valid_port() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_protocol() {
	case "$1" in http|https|ssh|tcp|rdp|smb) return 0 ;; *) return 1 ;; esac
}

valid_log_level() {
	case "$1" in debug|info|warn|error|fatal) return 0 ;; *) return 1 ;; esac
}

new_section_id() {
	local prefix="$1" random
	random="$(tr -d '-' < /proc/sys/kernel/random/uuid 2>/dev/null | cut -c 1-16)"
	[ -n "$random" ] || random="$(date +%s)$$"
	printf '%s_%s\n' "$prefix" "$random"
}

uci_get() {
	uci -q get "$CONF.$1.$2" 2>/dev/null || printf '%s\n' "${3:-}"
}

require_section_type() {
	valid_section "$1" || fail '配置标识无效'
	[ "$(uci -q get "$CONF.$1" 2>/dev/null || true)" = "$2" ] || fail '配置项不存在或类型不匹配'
}

token_hint() {
	local token="$1"
	printf '%s' "$token" | tail -c 4
}

account_secret_file() {
	printf '%s/%s.token\n' "$ACCOUNT_SECRET_ROOT" "$1"
}

tunnel_secret_file() {
	printf '%s/%s.token\n' "$TUNNEL_SECRET_ROOT" "$1"
}

api_request_file() {
	local token_file="$1" method="$2" endpoint="$3" body_file="${4:-}"
	local token curl_config http_code success error_message error_code
	API_OUTPUT=
	API_ERROR=
	API_HTTP=

	[ -x "$CURL_BIN" ] || {
		API_ERROR='curl 未安装'
		return 1
	}
	[ -s "$token_file" ] || {
		API_ERROR='API Token 尚未配置'
		return 1
	}
	token="$(cat "$token_file")"
	valid_secret "$token" 2048 || {
		API_ERROR='API Token 格式无效'
		return 1
	}

	API_SEQ=$((API_SEQ + 1))
	API_OUTPUT="$TEMP_PREFIX.api.$API_SEQ.json"
	curl_config="$TEMP_PREFIX.curl.$API_SEQ.conf"
	{
		printf 'silent\n'
		printf 'show-error\n'
		printf 'connect-timeout = 10\n'
		printf 'max-time = 30\n'
		printf 'retry = 1\n'
		printf 'header = "Authorization: Bearer %s"\n' "$token"
		printf 'header = "Content-Type: application/json"\n'
	} > "$curl_config"
	chmod 0600 "$curl_config"

	if [ -n "$body_file" ]; then
		if http_code="$("$CURL_BIN" --config "$curl_config" --request "$method" \
			--data-binary "@$body_file" --output "$API_OUTPUT" \
			--write-out '%{http_code}' --url "$API_BASE/$endpoint")"; then
			:
		else
			API_ERROR='无法连接 Cloudflare API'
			rm -f "$curl_config"
			return 1
		fi
	else
		if http_code="$("$CURL_BIN" --config "$curl_config" --request "$method" \
			--output "$API_OUTPUT" --write-out '%{http_code}' \
			--url "$API_BASE/$endpoint")"; then
			:
		else
			API_ERROR='无法连接 Cloudflare API'
			rm -f "$curl_config"
			return 1
		fi
	fi
	rm -f "$curl_config"
	API_HTTP="$http_code"

	success="$(jsonfilter -i "$API_OUTPUT" -e '@.success' 2>/dev/null | head -n 1 || true)"
	case "$http_code:$success" in
		2??:true) API_ERROR=; return 0 ;;
	esac

	error_message="$(jsonfilter -i "$API_OUTPUT" -e '@.errors[0].message' 2>/dev/null | head -n 1 || true)"
	error_code="$(jsonfilter -i "$API_OUTPUT" -e '@.errors[0].code' 2>/dev/null | head -n 1 || true)"
	API_ERROR="${error_message:-Cloudflare API 返回 HTTP $http_code}"
	[ -z "$error_code" ] || API_ERROR="$API_ERROR（$error_code）"
	return 1
}

api_for_account() {
	local section="$1" method="$2" endpoint="$3" body_file="${4:-}"
	api_request_file "$(account_secret_file "$section")" "$method" "$endpoint" "$body_file"
}

test_account_access() {
	local token_file="$1" account_id="$2" zone_id

	api_request_file "$token_file" GET "accounts/$account_id/cfd_tunnel?per_page=1" || return 1
	api_request_file "$token_file" GET "zones?account.id=$account_id&status=active&per_page=100" || return 1
	zone_id="$(jsonfilter -i "$API_OUTPUT" -e '@.result[0].id' 2>/dev/null | head -n 1 || true)"
	if [ -n "$zone_id" ]; then
		valid_zone_id "$zone_id" || {
			API_ERROR='Cloudflare 返回了无效的 Zone ID'
			return 1
		}
		api_request_file "$token_file" GET "zones/$zone_id/dns_records?per_page=1" || return 1
	fi
	return 0
}

count_account() {
	ACCOUNT_COUNT=$((ACCOUNT_COUNT + 1))
}

count_tunnel() {
	TUNNEL_COUNT=$((TUNNEL_COUNT + 1))
}

count_route() {
	ROUTE_COUNT=$((ROUTE_COUNT + 1))
}

route_count_for_tunnel_cb() {
	local section="$1" route_tunnel
	config_get route_tunnel "$section" tunnel
	[ "$route_tunnel" != "$COUNT_TUNNEL" ] || COUNT_RESULT=$((COUNT_RESULT + 1))
}

process_metrics() {
	local section="$1" pid stat_line stat_fields utime stime start_ticks rss system_uptime
	METRIC_RUNNING=0
	METRIC_PID=0
	METRIC_TICKS=0
	METRIC_RSS=0
	METRIC_UPTIME=0

	pid="$(cat "$RUNTIME_ROOT/$section.pid" 2>/dev/null || true)"
	case "$pid" in ''|*[!0-9]*) return 0 ;; esac
	[ -r "/proc/$pid/stat" ] || return 0
	stat_line="$(cat "/proc/$pid/stat" 2>/dev/null || true)"
	[ -n "$stat_line" ] || return 0
	stat_fields="${stat_line##*) }"
	set -f
	set -- $stat_fields
	[ "$#" -ge 20 ] || return 0
	utime="${12}"
	stime="${13}"
	start_ticks="${20}"
	case "$utime:$stime:$start_ticks" in *[!0-9:]*) return 0 ;; esac
	rss="$(awk '$1 == "VmRSS:" { print $2; exit }' "/proc/$pid/status" 2>/dev/null || true)"
	system_uptime="$(awk '{ print int($1); exit }' /proc/uptime 2>/dev/null || true)"
	case "$rss" in ''|*[!0-9]*) rss=0 ;; esac
	case "$system_uptime" in ''|*[!0-9]*) system_uptime=0 ;; esac

	METRIC_RUNNING=1
	METRIC_PID="$pid"
	METRIC_TICKS=$((utime + stime))
	METRIC_RSS="$rss"
	METRIC_UPTIME=$((system_uptime - start_ticks / 100))
	[ "$METRIC_UPTIME" -ge 0 ] || METRIC_UPTIME=0
}

emit_account_snapshot() {
	local section="$1" name account_id last_verified hint secret_file
	config_get name "$section" name
	config_get account_id "$section" account_id
	config_get last_verified "$section" last_verified '0'
	config_get hint "$section" token_hint
	secret_file="$(account_secret_file "$section")"

	json_add_object ""
	json_add_string section "$section"
	json_add_string name "$name"
	json_add_string account_id "$account_id"
	json_add_string token_hint "$hint"
	json_add_int last_verified "${last_verified:-0}"
	if [ -s "$secret_file" ]; then json_add_boolean token_set 1; else json_add_boolean token_set 0; fi
	json_close_object
}

emit_tunnel_snapshot() {
	local section="$1" account name tunnel_id enabled managed config_version protocol edge_ip_version
	local edge_bind_address grace_period retries region metrics token_file
	config_get account "$section" account
	config_get name "$section" name
	config_get tunnel_id "$section" tunnel_id
	config_get enabled "$section" enabled '0'
	config_get managed "$section" managed '0'
	config_get config_version "$section" config_version
	config_get protocol "$section" protocol 'auto'
	config_get edge_ip_version "$section" edge_ip_version 'auto'
	config_get edge_bind_address "$section" edge_bind_address
	config_get grace_period "$section" grace_period
	config_get retries "$section" retries
	config_get region "$section" region
	config_get metrics "$section" metrics
	token_file="$(tunnel_secret_file "$section")"
	COUNT_TUNNEL="$section"
	COUNT_RESULT=0
	config_foreach route_count_for_tunnel_cb route
	process_metrics "$section"

	json_add_object ""
	json_add_string section "$section"
	json_add_string account "$account"
	json_add_string name "$name"
	json_add_string tunnel_id "$tunnel_id"
	json_add_boolean enabled "$(bool_value "$enabled")"
	json_add_boolean managed "$(bool_value "$managed")"
	json_add_string config_version "$config_version"
	json_add_string protocol "$protocol"
	json_add_string edge_ip_version "$edge_ip_version"
	json_add_string edge_bind_address "$edge_bind_address"
	json_add_string grace_period "$grace_period"
	json_add_string retries "$retries"
	json_add_string region "$region"
	json_add_string metrics "$metrics"
	json_add_int route_count "$COUNT_RESULT"
	if [ -s "$token_file" ]; then json_add_boolean token_set 1; else json_add_boolean token_set 0; fi
	json_add_boolean running "$METRIC_RUNNING"
	json_add_int pid "$METRIC_PID"
	json_add_int process_ticks "$METRIC_TICKS"
	json_add_int rss_kb "$METRIC_RSS"
	json_add_int uptime_seconds "$METRIC_UPTIME"
	json_close_object
}

emit_route_snapshot() {
	local section="$1" tunnel zone_id zone_name hostname device_name device_mac origin_ip
	local protocol port path enabled dns_record_id managed_dns no_tls_verify
	local origin_server_name http_host_header connect_timeout
	config_get tunnel "$section" tunnel
	config_get zone_id "$section" zone_id
	config_get zone_name "$section" zone_name
	config_get hostname "$section" hostname
	config_get device_name "$section" device_name
	config_get device_mac "$section" device_mac
	config_get origin_ip "$section" origin_ip
	config_get protocol "$section" protocol
	config_get port "$section" port
	config_get path "$section" path
	config_get enabled "$section" enabled '1'
	config_get dns_record_id "$section" dns_record_id
	config_get managed_dns "$section" managed_dns '0'
	config_get no_tls_verify "$section" no_tls_verify '0'
	config_get origin_server_name "$section" origin_server_name
	config_get http_host_header "$section" http_host_header
	config_get connect_timeout "$section" connect_timeout

	json_add_object ""
	json_add_string section "$section"
	json_add_string tunnel "$tunnel"
	json_add_string zone_id "$zone_id"
	json_add_string zone_name "$zone_name"
	json_add_string hostname "$hostname"
	json_add_string device_name "$device_name"
	json_add_string device_mac "$device_mac"
	json_add_string origin_ip "$origin_ip"
	json_add_string protocol "$protocol"
	json_add_int port "${port:-0}"
	json_add_string path "$path"
	json_add_boolean enabled "$(bool_value "$enabled")"
	json_add_string dns_record_id "$dns_record_id"
	json_add_boolean managed_dns "$(bool_value "$managed_dns")"
	json_add_boolean no_tls_verify "$(bool_value "$no_tls_verify")"
	json_add_string origin_server_name "$origin_server_name"
	json_add_string http_host_header "$http_host_header"
	json_add_int connect_timeout "${connect_timeout:-0}"
	json_close_object
}

snapshot() {
	local version service_enabled system_ticks memory_total cpu_count interface loglevel manager_enabled
	ACCOUNT_COUNT=0
	TUNNEL_COUNT=0
	ROUTE_COUNT=0
	config_load "$CONF"
	config_foreach count_account account
	config_foreach count_tunnel tunnel
	config_foreach count_route route

	version="$("$PROG" --version 2>/dev/null | head -n 1 || true)"
	if "$INIT" enabled >/dev/null 2>&1; then service_enabled=1; else service_enabled=0; fi
	system_ticks="$(awk '/^cpu / { total = 0; for (i = 2; i <= 9; i++) total += $i; printf "%.0f\n", total; exit }' /proc/stat 2>/dev/null || true)"
	memory_total="$(awk '$1 == "MemTotal:" { print $2; exit }' /proc/meminfo 2>/dev/null || true)"
	cpu_count="$(grep -c '^processor[[:space:]]*:' /proc/cpuinfo 2>/dev/null || true)"
	interface="$(uci_get main interface wan)"
	loglevel="$(uci_get main loglevel info)"
	manager_enabled="$(uci_get main enabled 1)"
	case "$system_ticks" in ''|*[!0-9]*) system_ticks=0 ;; esac
	case "$memory_total" in ''|*[!0-9]*) memory_total=0 ;; esac
	case "$cpu_count" in ''|0|*[!0-9]*) cpu_count=1 ;; esac

	json_init
	json_add_string version "${version:-未安装}"
	json_add_boolean service_enabled "$service_enabled"
	json_add_boolean manager_enabled "$(bool_value "$manager_enabled")"
	json_add_string interface "$interface"
	json_add_string loglevel "$loglevel"
	json_add_int account_count "$ACCOUNT_COUNT"
	json_add_int tunnel_count "$TUNNEL_COUNT"
	json_add_int route_count "$ROUTE_COUNT"
	json_add_int system_ticks "$system_ticks"
	json_add_int memory_total_kb "$memory_total"
	json_add_int cpu_count "$cpu_count"
	json_add_array accounts
	config_foreach emit_account_snapshot account
	json_close_array
	json_add_array tunnels
	config_foreach emit_tunnel_snapshot tunnel
	json_close_array
	json_add_array routes
	config_foreach emit_route_snapshot route
	json_close_array
	json_dump
	printf '\n'
}

account_reference_cb() {
	local section="$1" account
	config_get account "$section" account
	[ "$account" != "$REFERENCE_ACCOUNT" ] || REFERENCE_FOUND=1
}

account_id_duplicate_cb() {
	local section="$1" account_id
	[ "$section" = "$ACCOUNT_SECTION" ] && return 0
	config_get account_id "$section" account_id
	[ "$account_id" != "$ACCOUNT_ID" ] || DUPLICATE_FOUND=1
}

save_account() {
	local section name account_id token candidate token_file test_token last_verified hint old_account_id
	section="$(request_value section)"
	name="$(request_value name)"
	account_id="$(request_value account_id)"
	token="$(request_value token)"
	safe_text "$name" 64 || fail '账号名称不能为空且不能包含控制字符'
	valid_account_id "$account_id" || fail 'Account ID 必须是 32 位十六进制字符串'

	if [ -n "$section" ]; then
		require_section_type "$section" account
		old_account_id="$(uci_get "$section" account_id)"
		if [ "$old_account_id" != "$account_id" ]; then
			REFERENCE_ACCOUNT="$section"
			REFERENCE_FOUND=0
			config_load "$CONF"
			config_foreach account_reference_cb tunnel
			[ "$REFERENCE_FOUND" -eq 0 ] || fail '该账号已有 Tunnel，不能修改 Account ID'
		fi
	else
		section="$(new_section_id account)"
		old_account_id=
	fi

	ACCOUNT_SECTION="$section"
	ACCOUNT_ID="$account_id"
	DUPLICATE_FOUND=0
	config_load "$CONF"
	config_foreach account_id_duplicate_cb account
	[ "$DUPLICATE_FOUND" -eq 0 ] || fail '这个 Account ID 已经添加'

	token_file="$(account_secret_file "$section")"
	candidate="$TEMP_PREFIX.account-token"
	if [ -n "$token" ]; then
		valid_secret "$token" 2048 || fail 'API Token 格式无效'
		printf '%s' "$token" > "$candidate"
		chmod 0600 "$candidate"
		test_token="$candidate"
	else
		[ -s "$token_file" ] || fail '首次添加账号必须填写 API Token'
		test_token="$token_file"
		token="$(cat "$token_file")"
	fi

	if ! test_account_access "$test_token" "$account_id"; then
		fail "账号或 Token 验证失败：$API_ERROR"
	fi

	last_verified="$(date +%s)"
	hint="$(token_hint "$token")"
	uci -q set "$CONF.$section=account"
	uci -q set "$CONF.$section.name=$name"
	uci -q set "$CONF.$section.account_id=$account_id"
	uci -q set "$CONF.$section.token_hint=$hint"
	uci -q set "$CONF.$section.last_verified=$last_verified"
	uci -q commit "$CONF" || fail '保存账号配置失败'
	if [ -s "$candidate" ]; then
		mv -f "$candidate" "$token_file"
		chmod 0600 "$token_file"
	fi

	log_event info account "Saved account $section"
	json_init
	json_add_boolean success 1
	json_add_string message '账号验证并保存成功'
	json_add_string section "$section"
	json_dump
	printf '\n'
}

verify_account() {
	local section account_id token_file now
	section="$(request_value section)"
	require_section_type "$section" account
	account_id="$(uci_get "$section" account_id)"
	token_file="$(account_secret_file "$section")"
	if ! test_account_access "$token_file" "$account_id"; then
		fail "账号验证失败：$API_ERROR"
	fi
	now="$(date +%s)"
	uci -q set "$CONF.$section.last_verified=$now"
	uci -q commit "$CONF"
	log_event info account "Verified account $section"
	emit_message 'Token、Tunnel 读取和 DNS 读取权限验证成功'
}

delete_account() {
	local section
	section="$(request_value section)"
	require_section_type "$section" account
	REFERENCE_ACCOUNT="$section"
	REFERENCE_FOUND=0
	config_load "$CONF"
	config_foreach account_reference_cb tunnel
	[ "$REFERENCE_FOUND" -eq 0 ] || fail '请先删除该账号下的本地 Tunnel'
	rm -f "$(account_secret_file "$section")"
	uci -q delete "$CONF.$section"
	uci -q commit "$CONF"
	log_event info account "Deleted account $section"
	emit_message '账号已从路由器删除'
}

list_zones() {
	local section account_id
	section="$1"
	require_section_type "$section" account
	account_id="$(uci_get "$section" account_id)"
	api_for_account "$section" GET "zones?account.id=$account_id&status=active&per_page=100" || \
		fail "读取域名失败：$API_ERROR"
	cat "$API_OUTPUT"
	printf '\n'
}

list_remote_tunnels() {
	local section account_id
	section="$1"
	require_section_type "$section" account
	account_id="$(uci_get "$section" account_id)"
	api_for_account "$section" GET "accounts/$account_id/cfd_tunnel?is_deleted=false&per_page=100" || \
		fail "读取 Tunnel 失败：$API_ERROR"
	cat "$API_OUTPUT"
	printf '\n'
}

request_bool() {
	bool_value "$(request_value "$1")"
}

uci_set_or_delete() {
	local section="$1" option="$2" value="$3"
	if [ -n "$value" ]; then
		uci -q set "$CONF.$section.$option=$value"
	else
		uci -q delete "$CONF.$section.$option" 2>/dev/null || true
	fi
}

reload_manager() {
	"$INIT" restart >/dev/null 2>&1 || true
}

tunnel_id_duplicate_cb() {
	local section="$1" tunnel_id
	[ "$section" = "$TUNNEL_SECTION" ] && return 0
	config_get tunnel_id "$section" tunnel_id
	[ "$tunnel_id" != "$TUNNEL_ID" ] || DUPLICATE_FOUND=1
}

tunnel_name_duplicate_cb() {
	local section="$1" account name
	[ "$section" = "$TUNNEL_SECTION" ] && return 0
	config_get account "$section" account
	config_get name "$section" name
	[ "$account:$name" != "$TUNNEL_ACCOUNT:$TUNNEL_NAME" ] || DUPLICATE_FOUND=1
}

assert_tunnel_unique() {
	TUNNEL_SECTION="$1"
	TUNNEL_ACCOUNT="$2"
	TUNNEL_ID="$3"
	TUNNEL_NAME="$4"
	DUPLICATE_FOUND=0
	config_load "$CONF"
	config_foreach tunnel_id_duplicate_cb tunnel
	[ "$DUPLICATE_FOUND" -eq 0 ] || fail '这个 Tunnel 已经导入'
	DUPLICATE_FOUND=0
	config_foreach tunnel_name_duplicate_cb tunnel
	[ "$DUPLICATE_FOUND" -eq 0 ] || fail '同一账号内的 Tunnel 名称不能重复'
}

fetch_remote_config() {
	local tunnel_section="$1" account account_id tunnel_id
	account="$(uci_get "$tunnel_section" account)"
	account_id="$(uci_get "$account" account_id)"
	tunnel_id="$(uci_get "$tunnel_section" tunnel_id)"
	api_for_account "$account" GET \
		"accounts/$account_id/cfd_tunnel/$tunnel_id/configurations" || return 1
	REMOTE_CONFIG_FILE="$TEMP_PREFIX.remote-config.json"
	cp "$API_OUTPUT" "$REMOTE_CONFIG_FILE"
	REMOTE_VERSION="$(jsonfilter -i "$REMOTE_CONFIG_FILE" -e '@.result.version' 2>/dev/null | head -n 1 || true)"
	return 0
}

assert_remote_version() {
	local tunnel_section="$1" stored
	stored="$(uci_get "$tunnel_section" config_version)"
	[ -z "$stored" ] || [ "$stored" = "$REMOTE_VERSION" ] || \
		fail 'Cloudflare 控制台中的 Tunnel 配置已被其他人修改，请先重新导入后再操作'
}

build_ingress_route_cb() {
	local section="$1" tunnel enabled hostname origin_ip protocol port path
	local no_tls_verify origin_server_name http_host_header connect_timeout has_origin=0
	config_get tunnel "$section" tunnel
	config_get_bool enabled "$section" enabled '1'
	[ "$tunnel" = "$BUILD_TUNNEL" ] && [ "$enabled" -eq 1 ] || return 0
	config_get hostname "$section" hostname
	config_get origin_ip "$section" origin_ip
	config_get protocol "$section" protocol
	config_get port "$section" port
	config_get path "$section" path
	config_get_bool no_tls_verify "$section" no_tls_verify '0'
	config_get origin_server_name "$section" origin_server_name
	config_get http_host_header "$section" http_host_header
	config_get connect_timeout "$section" connect_timeout

	json_add_object ""
	json_add_string hostname "$hostname"
	[ -z "$path" ] || json_add_string path "$path"
	json_add_string service "$protocol://$origin_ip:$port"
	[ "$no_tls_verify" -eq 0 ] || has_origin=1
	[ -z "$origin_server_name" ] || has_origin=1
	[ -z "$http_host_header" ] || has_origin=1
	[ -z "$connect_timeout" ] || has_origin=1
	if [ "$has_origin" -eq 1 ]; then
		json_add_object originRequest
		[ "$no_tls_verify" -eq 0 ] || json_add_boolean noTLSVerify 1
		[ -z "$origin_server_name" ] || json_add_string originServerName "$origin_server_name"
		[ -z "$http_host_header" ] || json_add_string httpHostHeader "$http_host_header"
		[ -z "$connect_timeout" ] || json_add_string connectTimeout "${connect_timeout}s"
		json_close_object
	fi
	json_close_object
}

build_tunnel_config_body() {
	local tunnel_section="$1" output="$2"
	BUILD_TUNNEL="$tunnel_section"
	config_load "$CONF"
	json_init
	json_add_object config
	json_add_array ingress
	config_foreach build_ingress_route_cb route
	json_add_object ""
	json_add_string service 'http_status:404'
	json_close_object
	json_close_array
	json_close_object
	json_dump > "$output"
}

build_empty_config_body() {
	local output="$1"
	json_init
	json_add_object config
	json_add_array ingress
	json_add_object ""
	json_add_string service 'http_status:404'
	json_close_object
	json_close_array
	json_close_object
	json_dump > "$output"
}

put_tunnel_config() {
	local account="$1" account_id="$2" tunnel_id="$3" body_file="$4"
	api_for_account "$account" PUT \
		"accounts/$account_id/cfd_tunnel/$tunnel_id/configurations" "$body_file" || return 1
	NEW_CONFIG_VERSION="$(jsonfilter -i "$API_OUTPUT" -e '@.result.version' 2>/dev/null | head -n 1 || true)"
	[ -n "$NEW_CONFIG_VERSION" ] || {
		API_ERROR='Cloudflare 未返回配置版本号'
		return 1
	}
	return 0
}

rollback_remote_config() {
	local account="$1" account_id="$2" tunnel_id="$3" snapshot_file="$4"
	local config_json restore_body
	ROLLBACK_VERSION=
	config_json="$(jsonfilter -i "$snapshot_file" -e '@.result.config' 2>/dev/null || true)"
	[ -n "$config_json" ] || return 1
	restore_body="$TEMP_PREFIX.restore-config.json"
	printf '{"config":%s}\n' "$config_json" > "$restore_body"
	if put_tunnel_config "$account" "$account_id" "$tunnel_id" "$restore_body"; then
		ROLLBACK_VERSION="$NEW_CONFIG_VERSION"
		return 0
	fi
	return 1
}

save_tunnel_local() {
	local section="$1" account="$2" name="$3" tunnel_id="$4" managed="$5"
	local enabled="$6" config_version="$7"
	uci -q set "$CONF.$section=tunnel"
	uci -q set "$CONF.$section.account=$account"
	uci -q set "$CONF.$section.name=$name"
	uci -q set "$CONF.$section.tunnel_id=$tunnel_id"
	uci -q set "$CONF.$section.managed=$managed"
	uci -q set "$CONF.$section.enabled=$enabled"
	uci -q set "$CONF.$section.config_version=$config_version"
	uci -q set "$CONF.$section.protocol=auto"
	uci -q set "$CONF.$section.edge_ip_version=auto"
	uci -q commit "$CONF"
}

create_tunnel() {
	local account name account_id section body tunnel_id token token_file config_body error
	account="$(request_value account)"
	name="$(request_value name)"
	require_section_type "$account" account
	safe_text "$name" 64 || fail 'Tunnel 名称不能为空且不能包含控制字符'
	account_id="$(uci_get "$account" account_id)"

	section="$(new_section_id tunnel)"
	assert_tunnel_unique "$section" "$account" '00000000-0000-0000-0000-000000000000' "$name"
	body="$TEMP_PREFIX.create-tunnel.json"
	json_init
	json_add_string name "$name"
	json_add_string config_src cloudflare
	json_dump > "$body"
	api_for_account "$account" POST "accounts/$account_id/cfd_tunnel" "$body" || \
		fail "创建 Tunnel 失败：$API_ERROR"
	tunnel_id="$(jsonfilter -i "$API_OUTPUT" -e '@.result.id' 2>/dev/null | head -n 1 || true)"
	valid_uuid "$tunnel_id" || fail 'Cloudflare 返回了无效的 Tunnel ID'

	config_body="$TEMP_PREFIX.initial-config.json"
	build_empty_config_body "$config_body"
	if ! put_tunnel_config "$account" "$account_id" "$tunnel_id" "$config_body"; then
		error="$API_ERROR"
		api_for_account "$account" DELETE "accounts/$account_id/cfd_tunnel/$tunnel_id" >/dev/null 2>&1 || true
		fail "初始化 Tunnel 配置失败，已回滚：$error"
	fi
	api_for_account "$account" GET "accounts/$account_id/cfd_tunnel/$tunnel_id/token" || {
		error="$API_ERROR"
		api_for_account "$account" DELETE "accounts/$account_id/cfd_tunnel/$tunnel_id" >/dev/null 2>&1 || true
		fail "读取 Tunnel Token 失败，已回滚：$error"
	}
	token="$(jsonfilter -i "$API_OUTPUT" -e '@.result' 2>/dev/null | head -n 1 || true)"
	valid_secret "$token" 4096 || {
		api_for_account "$account" DELETE "accounts/$account_id/cfd_tunnel/$tunnel_id" >/dev/null 2>&1 || true
		fail 'Cloudflare 返回的 Tunnel Token 无效，已回滚'
	}
	token_file="$(tunnel_secret_file "$section")"
	printf '%s' "$token" > "$token_file"
	chmod 0600 "$token_file"
	save_tunnel_local "$section" "$account" "$name" "$tunnel_id" 1 1 "$NEW_CONFIG_VERSION"
	reload_manager
	log_event info tunnel "Created tunnel $section"
	json_init
	json_add_boolean success 1
	json_add_string message 'Tunnel 已创建并启动'
	json_add_string section "$section"
	json_dump
	printf '\n'
}

import_tunnel() {
	local account tunnel_id account_id section enabled name token config_version token_file
	account="$(request_value account)"
	tunnel_id="$(request_value tunnel_id)"
	enabled="$(request_bool enabled)"
	require_section_type "$account" account
	valid_uuid "$tunnel_id" || fail 'Tunnel ID 格式无效'
	account_id="$(uci_get "$account" account_id)"
	api_for_account "$account" GET "accounts/$account_id/cfd_tunnel/$tunnel_id" || \
		fail "读取 Tunnel 详情失败：$API_ERROR"
	name="$(jsonfilter -i "$API_OUTPUT" -e '@.result.name' 2>/dev/null | head -n 1 || true)"
	safe_text "$name" 64 || fail 'Cloudflare 返回了无效的 Tunnel 名称'
	section="$(new_section_id tunnel)"
	assert_tunnel_unique "$section" "$account" "$tunnel_id" "$name"

	api_for_account "$account" GET "accounts/$account_id/cfd_tunnel/$tunnel_id/configurations" || \
		fail "读取 Tunnel 配置失败：$API_ERROR"
	config_version="$(jsonfilter -i "$API_OUTPUT" -e '@.result.version' 2>/dev/null | head -n 1 || true)"
	api_for_account "$account" GET "accounts/$account_id/cfd_tunnel/$tunnel_id/token" || \
		fail "读取 Tunnel Token 失败：$API_ERROR"
	token="$(jsonfilter -i "$API_OUTPUT" -e '@.result' 2>/dev/null | head -n 1 || true)"
	valid_secret "$token" 4096 || fail 'Cloudflare 返回的 Tunnel Token 无效'
	token_file="$(tunnel_secret_file "$section")"
	printf '%s' "$token" > "$token_file"
	chmod 0600 "$token_file"
	save_tunnel_local "$section" "$account" "$name" "$tunnel_id" 0 "$enabled" "$config_version"
	reload_manager
	log_event info tunnel "Imported tunnel $section"
	emit_message 'Tunnel 已导入；远端规则保持只读，避免覆盖控制台配置'
}

route_reference_cb() {
	local section="$1" tunnel
	config_get tunnel "$section" tunnel
	[ "$tunnel" != "$REFERENCE_TUNNEL" ] || REFERENCE_FOUND=1
}

save_tunnel_settings() {
	local section enabled protocol edge_ip_version edge_bind_address grace_period retries region metrics
	section="$(request_value section)"
	enabled="$(request_bool enabled)"
	protocol="$(request_value protocol)"
	edge_ip_version="$(request_value edge_ip_version)"
	edge_bind_address="$(request_value edge_bind_address)"
	grace_period="$(request_value grace_period)"
	retries="$(request_value retries)"
	region="$(request_value region)"
	metrics="$(request_value metrics)"
	require_section_type "$section" tunnel
	case "$protocol" in auto|quic|http2) ;; *) fail '连接协议无效' ;; esac
	case "$edge_ip_version" in auto|4|6) ;; *) fail '边缘 IP 版本无效' ;; esac
	[ -z "$edge_bind_address" ] || valid_ipv4 "$edge_bind_address" || fail '边缘绑定地址无效'
	[ -z "$grace_period" ] || printf '%s' "$grace_period" | grep -Eq '^[1-9][0-9]*[smh]$' || fail '优雅退出时间格式无效'
	[ -z "$retries" ] || { case "$retries" in *[!0-9]*|'') fail '重试次数无效' ;; esac; }
	[ -z "$region" ] || safe_text "$region" 32 || fail 'Region 格式无效'
	[ -z "$metrics" ] || printf '%s' "$metrics" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]{1,5}$|^localhost:[0-9]{1,5}$' || fail 'Metrics 地址格式无效'
	uci -q set "$CONF.$section.enabled=$enabled"
	uci -q set "$CONF.$section.protocol=$protocol"
	uci -q set "$CONF.$section.edge_ip_version=$edge_ip_version"
	uci_set_or_delete "$section" edge_bind_address "$edge_bind_address"
	uci_set_or_delete "$section" grace_period "$grace_period"
	uci_set_or_delete "$section" retries "$retries"
	uci_set_or_delete "$section" region "$region"
	uci_set_or_delete "$section" metrics "$metrics"
	uci -q commit "$CONF"
	reload_manager
	log_event info tunnel "Updated tunnel settings $section"
	emit_message 'Tunnel 运行参数已保存'
}

toggle_tunnel() {
	local section enabled
	section="$(request_value section)"
	enabled="$(request_bool enabled)"
	require_section_type "$section" tunnel
	uci -q set "$CONF.$section.enabled=$enabled"
	uci -q commit "$CONF"
	reload_manager
	log_event info tunnel "Set tunnel $section enabled=$enabled"
	if [ "$enabled" -eq 1 ]; then
		emit_message 'Tunnel 已启动'
	else
		emit_message 'Tunnel 已停止'
	fi
}

delete_tunnel() {
	local section delete_remote account account_id tunnel_id enabled error
	section="$(request_value section)"
	delete_remote="$(request_bool delete_remote)"
	require_section_type "$section" tunnel
	REFERENCE_TUNNEL="$section"
	REFERENCE_FOUND=0
	config_load "$CONF"
	config_foreach route_reference_cb route
	[ "$REFERENCE_FOUND" -eq 0 ] || fail '请先删除该 Tunnel 下的穿透规则'
	account="$(uci_get "$section" account)"
	account_id="$(uci_get "$account" account_id)"
	tunnel_id="$(uci_get "$section" tunnel_id)"
	enabled="$(uci_get "$section" enabled 0)"
	uci -q set "$CONF.$section.enabled=0"
	uci -q commit "$CONF"
	reload_manager
	if [ "$delete_remote" -eq 1 ]; then
		if ! api_for_account "$account" DELETE "accounts/$account_id/cfd_tunnel/$tunnel_id"; then
			error="$API_ERROR"
			uci -q set "$CONF.$section.enabled=$enabled"
			uci -q commit "$CONF"
			reload_manager
			fail "删除 Cloudflare Tunnel 失败，本地状态已恢复：$error"
		fi
	fi
	rm -f "$(tunnel_secret_file "$section")" "$LOG_ROOT/$section.log" "$RUNTIME_ROOT/$section.pid"
	uci -q delete "$CONF.$section"
	uci -q commit "$CONF"
	log_event info tunnel "Deleted tunnel $section remote=$delete_remote"
	emit_message 'Tunnel 已删除'
}

validate_zone_for_account() {
	local account="$1" zone_id="$2" account_id remote_account
	account_id="$(uci_get "$account" account_id)"
	api_for_account "$account" GET "zones/$zone_id" || return 1
	ZONE_NAME="$(jsonfilter -i "$API_OUTPUT" -e '@.result.name' 2>/dev/null | head -n 1 || true)"
	remote_account="$(jsonfilter -i "$API_OUTPUT" -e '@.result.account.id' 2>/dev/null | head -n 1 || true)"
	valid_hostname "$ZONE_NAME" || {
		API_ERROR='Cloudflare 返回了无效的 Zone 名称'
		return 1
	}
	[ "$remote_account" = "$account_id" ] || {
		API_ERROR='所选域名不属于这个 Cloudflare 账号'
		return 1
	}
	return 0
}

hostname_duplicate_cb() {
	local section="$1" hostname
	[ "$section" = "$ROUTE_SECTION" ] && return 0
	config_get hostname "$section" hostname
	[ "$hostname" != "$ROUTE_HOSTNAME" ] || DUPLICATE_FOUND=1
}

assert_hostname_unique() {
	ROUTE_SECTION="$1"
	ROUTE_HOSTNAME="$2"
	DUPLICATE_FOUND=0
	config_load "$CONF"
	config_foreach hostname_duplicate_cb route
	[ "$DUPLICATE_FOUND" -eq 0 ] || fail '这个域名已被另一条穿透规则使用'
}

ensure_dns_record() {
	local account="$1" zone_id="$2" hostname="$3" tunnel_id="$4"
	local target count record_id record_type content comment body
	DNS_ID=
	DNS_MANAGED=0
	DNS_CREATED=0
	DNS_ERROR=
	target="$tunnel_id.cfargotunnel.com"
	if ! api_for_account "$account" GET "zones/$zone_id/dns_records?name=$hostname&per_page=100"; then
		DNS_ERROR="$API_ERROR"
		return 1
	fi
	count="$(jsonfilter -i "$API_OUTPUT" -e '@.result[*].id' 2>/dev/null | wc -l | tr -d ' ')"
	case "$count" in ''|*[!0-9]*) count=0 ;; esac
	[ "$count" -le 1 ] || {
		DNS_ERROR='该域名存在多条 DNS 记录，请先在 Cloudflare 控制台整理'
		return 1
	}
	if [ "$count" -eq 1 ]; then
		record_id="$(jsonfilter -i "$API_OUTPUT" -e '@.result[0].id' 2>/dev/null | head -n 1 || true)"
		record_type="$(jsonfilter -i "$API_OUTPUT" -e '@.result[0].type' 2>/dev/null | head -n 1 || true)"
		content="$(jsonfilter -i "$API_OUTPUT" -e '@.result[0].content' 2>/dev/null | head -n 1 || true)"
		comment="$(jsonfilter -i "$API_OUTPUT" -e '@.result[0].comment' 2>/dev/null | head -n 1 || true)"
		if [ "$record_type" != CNAME ] || [ "$content" != "$target" ]; then
			DNS_ERROR='该域名已有其他 DNS 记录；为防止覆盖，管理器已停止操作'
			return 1
		fi
		DNS_ID="$record_id"
		[ "$comment" != 'Managed by OpenWRT-CI Cloudflare Tunnel Manager' ] || DNS_MANAGED=1
		return 0
	fi

	body="$TEMP_PREFIX.create-dns.json"
	json_init
	json_add_string type CNAME
	json_add_string name "$hostname"
	json_add_string content "$target"
	json_add_boolean proxied 1
	json_add_int ttl 1
	json_add_string comment 'Managed by OpenWRT-CI Cloudflare Tunnel Manager'
	json_dump > "$body"
	if ! api_for_account "$account" POST "zones/$zone_id/dns_records" "$body"; then
		DNS_ERROR="$API_ERROR"
		return 1
	fi
	record_id="$(jsonfilter -i "$API_OUTPUT" -e '@.result.id' 2>/dev/null | head -n 1 || true)"
	valid_zone_id "$record_id" || {
		DNS_ERROR='Cloudflare 未返回有效的 DNS Record ID'
		return 1
	}
	DNS_ID="$record_id"
	DNS_MANAGED=1
	DNS_CREATED=1
	return 0
}

delete_owned_dns_record() {
	local account="$1" zone_id="$2" record_id="$3" tunnel_id="$4"
	local comment content target
	DNS_ERROR=
	[ -n "$record_id" ] || return 0
	target="$tunnel_id.cfargotunnel.com"
	if ! api_for_account "$account" GET "zones/$zone_id/dns_records/$record_id"; then
		[ "$API_HTTP" = 404 ] && return 0
		DNS_ERROR="$API_ERROR"
		return 1
	fi
	comment="$(jsonfilter -i "$API_OUTPUT" -e '@.result.comment' 2>/dev/null | head -n 1 || true)"
	content="$(jsonfilter -i "$API_OUTPUT" -e '@.result.content' 2>/dev/null | head -n 1 || true)"
	if [ "$comment" != 'Managed by OpenWRT-CI Cloudflare Tunnel Manager' ] || [ "$content" != "$target" ]; then
		DNS_ERROR='DNS 记录已在外部修改，管理器拒绝删除'
		return 1
	fi
	if ! api_for_account "$account" DELETE "zones/$zone_id/dns_records/$record_id"; then
		[ "$API_HTTP" = 404 ] && return 0
		DNS_ERROR="$API_ERROR"
		return 1
	fi
	return 0
}

backup_uci_config() {
	UCI_BACKUP="$TEMP_PREFIX.uci-backup"
	cp "/etc/config/$CONF" "$UCI_BACKUP"
	chmod 0600 "$UCI_BACKUP"
}

restore_uci_config() {
	local tunnel_section="$1" version="$2"
	cp "$UCI_BACKUP" "/etc/config/$CONF"
	chmod 0600 "/etc/config/$CONF"
	if [ -n "$version" ]; then
		uci -q set "$CONF.$tunnel_section.config_version=$version"
		uci -q commit "$CONF"
	fi
}

rollback_route_transaction() {
	local message="$1" rollback_ok=0
	if [ "${TX_DNS_CREATED:-0}" -eq 1 ] && [ -n "${TX_DNS_ID:-}" ]; then
		delete_owned_dns_record "$TX_ACCOUNT" "$TX_ZONE_ID" "$TX_DNS_ID" "$TX_TUNNEL_ID" >/dev/null 2>&1 || true
	fi
	if rollback_remote_config "$TX_ACCOUNT" "$TX_ACCOUNT_ID" "$TX_TUNNEL_ID" "$TX_REMOTE_FILE"; then
		rollback_ok=1
	else
		log_event error rollback "Unable to restore remote config for $TX_TUNNEL_SECTION: $API_ERROR"
	fi
	if [ "$rollback_ok" -eq 1 ]; then
		restore_uci_config "$TX_TUNNEL_SECTION" "$ROLLBACK_VERSION"
	else
		restore_uci_config "$TX_TUNNEL_SECTION" ''
	fi
	log_event warn rollback "$message"
	fail "$message"
}

save_route() {
	local section tunnel zone_id hostname device_name device_mac origin_ip protocol port path enabled
	local no_tls_verify origin_server_name http_host_header connect_timeout managed account account_id tunnel_id
	local old_zone_id old_dns_id old_managed_dns old_enabled body error
	section="$(request_value section)"
	tunnel="$(request_value tunnel)"
	zone_id="$(request_value zone_id)"
	hostname="$(request_value hostname | tr 'A-Z' 'a-z')"
	device_name="$(request_value device_name)"
	device_mac="$(request_value device_mac | tr 'A-F' 'a-f')"
	origin_ip="$(request_value origin_ip)"
	protocol="$(request_value protocol)"
	port="$(request_value port)"
	path="$(request_value path)"
	enabled="$(request_bool enabled)"
	no_tls_verify="$(request_bool no_tls_verify)"
	origin_server_name="$(request_value origin_server_name)"
	http_host_header="$(request_value http_host_header)"
	connect_timeout="$(request_value connect_timeout)"

	require_section_type "$tunnel" tunnel
	managed="$(uci_get "$tunnel" managed 0)"
	[ "$managed" = 1 ] || fail '导入的 Tunnel 为只读；请新建由本管理器维护的 Tunnel'
	valid_zone_id "$zone_id" || fail 'Zone ID 格式无效'
	valid_hostname "$hostname" || fail '完整域名格式无效'
	valid_ipv4 "$origin_ip" || fail '设备 IPv4 地址无效'
	valid_mac "$device_mac" || fail '设备 MAC 地址无效'
	valid_protocol "$protocol" || fail '源服务协议无效'
	valid_port "$port" || fail '源服务端口必须在 1 到 65535 之间'
	[ -z "$device_name" ] || safe_text "$device_name" 64 || fail '设备名称格式无效'
	if [ -n "$path" ]; then
		safe_text "$path" 256 || fail 'URL 路径格式无效'
		case "$path" in /*) ;; *) fail 'URL 路径必须以 / 开头' ;; esac
	fi
	[ -z "$origin_server_name" ] || valid_hostname "$origin_server_name" || fail 'Origin Server Name 格式无效'
	[ -z "$http_host_header" ] || valid_hostname "$http_host_header" || fail 'HTTP Host Header 格式无效'
	if [ -n "$connect_timeout" ]; then
		case "$connect_timeout" in *[!0-9]*) fail '连接超时必须是整数秒' ;; esac
		if [ "$connect_timeout" -lt 1 ] || [ "$connect_timeout" -gt 300 ]; then
			fail '连接超时必须在 1 到 300 秒之间'
		fi
	fi

	if [ -n "$section" ]; then
		require_section_type "$section" route
		[ "$(uci_get "$section" tunnel)" = "$tunnel" ] || fail '现有规则不能迁移到另一个 Tunnel，请新建规则'
		old_zone_id="$(uci_get "$section" zone_id)"
		old_dns_id="$(uci_get "$section" dns_record_id)"
		old_managed_dns="$(uci_get "$section" managed_dns 0)"
		old_enabled="$(uci_get "$section" enabled 1)"
	else
		section="$(new_section_id route)"
		old_zone_id=
		old_dns_id=
		old_managed_dns=0
		old_enabled=0
	fi
	assert_hostname_unique "$section" "$hostname"
	account="$(uci_get "$tunnel" account)"
	account_id="$(uci_get "$account" account_id)"
	tunnel_id="$(uci_get "$tunnel" tunnel_id)"
	if ! validate_zone_for_account "$account" "$zone_id"; then
		fail "域名验证失败：$API_ERROR"
	fi
	case "$hostname" in "$ZONE_NAME"|*."$ZONE_NAME") ;; *) fail '完整域名不属于所选 Zone' ;; esac

	backup_uci_config
	if ! fetch_remote_config "$tunnel"; then
		fail "读取当前 Tunnel 配置失败：$API_ERROR"
	fi
	assert_remote_version "$tunnel"
	TX_ACCOUNT="$account"
	TX_ACCOUNT_ID="$account_id"
	TX_TUNNEL_ID="$tunnel_id"
	TX_TUNNEL_SECTION="$tunnel"
	TX_REMOTE_FILE="$REMOTE_CONFIG_FILE"
	TX_ZONE_ID="$zone_id"
	TX_DNS_ID=
	TX_DNS_CREATED=0

	uci -q set "$CONF.$section=route"
	uci -q set "$CONF.$section.tunnel=$tunnel"
	uci -q set "$CONF.$section.zone_id=$zone_id"
	uci -q set "$CONF.$section.zone_name=$ZONE_NAME"
	uci -q set "$CONF.$section.hostname=$hostname"
	uci_set_or_delete "$section" device_name "$device_name"
	uci_set_or_delete "$section" device_mac "$device_mac"
	uci -q set "$CONF.$section.origin_ip=$origin_ip"
	uci -q set "$CONF.$section.protocol=$protocol"
	uci -q set "$CONF.$section.port=$port"
	uci_set_or_delete "$section" path "$path"
	uci -q set "$CONF.$section.enabled=$enabled"
	uci -q set "$CONF.$section.no_tls_verify=$no_tls_verify"
	uci_set_or_delete "$section" origin_server_name "$origin_server_name"
	uci_set_or_delete "$section" http_host_header "$http_host_header"
	uci_set_or_delete "$section" connect_timeout "$connect_timeout"
	uci -q delete "$CONF.$section.dns_record_id" 2>/dev/null || true
	uci -q delete "$CONF.$section.managed_dns" 2>/dev/null || true
	uci -q commit "$CONF"

	body="$TEMP_PREFIX.tunnel-config.json"
	build_tunnel_config_body "$tunnel" "$body"
	if ! put_tunnel_config "$account" "$account_id" "$tunnel_id" "$body"; then
		error="$API_ERROR"
		restore_uci_config "$tunnel" ''
		fail "更新 Tunnel Ingress 失败，本地配置已恢复：$error"
	fi
	if [ "$enabled" -eq 1 ]; then
		if ! ensure_dns_record "$account" "$zone_id" "$hostname" "$tunnel_id"; then
			error="$DNS_ERROR"
			rollback_route_transaction "创建 DNS 记录失败，已回滚 Ingress：$error"
		fi
		TX_DNS_ID="$DNS_ID"
		TX_DNS_CREATED="$DNS_CREATED"
	fi

	if [ "$old_managed_dns" = 1 ] && [ -n "$old_dns_id" ] && \
		{ [ "$old_enabled" = 1 ] && { [ "$enabled" = 0 ] || [ "$old_zone_id:$old_dns_id" != "$zone_id:${DNS_ID:-}" ]; }; }; then
		if ! delete_owned_dns_record "$account" "$old_zone_id" "$old_dns_id" "$tunnel_id"; then
			error="$DNS_ERROR"
			rollback_route_transaction "清理旧 DNS 记录失败，所有更改已回滚：$error"
		fi
	fi

	if [ "$enabled" -eq 1 ]; then
		uci -q set "$CONF.$section.dns_record_id=$DNS_ID"
		uci -q set "$CONF.$section.managed_dns=$DNS_MANAGED"
	else
		uci -q delete "$CONF.$section.dns_record_id" 2>/dev/null || true
		uci -q set "$CONF.$section.managed_dns=0"
	fi
	uci -q set "$CONF.$tunnel.config_version=$NEW_CONFIG_VERSION"
	uci -q commit "$CONF"
	log_event info route "Saved route $section for $hostname"
	json_init
	json_add_boolean success 1
	json_add_string message '穿透规则、Ingress 和 DNS 已同步'
	json_add_string section "$section"
	json_dump
	printf '\n'
}

delete_route() {
	local section tunnel account account_id tunnel_id zone_id dns_id managed_dns body error
	section="$(request_value section)"
	require_section_type "$section" route
	tunnel="$(uci_get "$section" tunnel)"
	require_section_type "$tunnel" tunnel
	[ "$(uci_get "$tunnel" managed 0)" = 1 ] || fail '只读 Tunnel 的本地规则不能由管理器修改'
	account="$(uci_get "$tunnel" account)"
	account_id="$(uci_get "$account" account_id)"
	tunnel_id="$(uci_get "$tunnel" tunnel_id)"
	zone_id="$(uci_get "$section" zone_id)"
	dns_id="$(uci_get "$section" dns_record_id)"
	managed_dns="$(uci_get "$section" managed_dns 0)"
	backup_uci_config
	if ! fetch_remote_config "$tunnel"; then
		fail "读取当前 Tunnel 配置失败：$API_ERROR"
	fi
	assert_remote_version "$tunnel"
	TX_ACCOUNT="$account"
	TX_ACCOUNT_ID="$account_id"
	TX_TUNNEL_ID="$tunnel_id"
	TX_TUNNEL_SECTION="$tunnel"
	TX_REMOTE_FILE="$REMOTE_CONFIG_FILE"
	TX_ZONE_ID="$zone_id"
	TX_DNS_ID=
	TX_DNS_CREATED=0
	uci -q delete "$CONF.$section"
	uci -q commit "$CONF"
	body="$TEMP_PREFIX.tunnel-config.json"
	build_tunnel_config_body "$tunnel" "$body"
	if ! put_tunnel_config "$account" "$account_id" "$tunnel_id" "$body"; then
		error="$API_ERROR"
		restore_uci_config "$tunnel" ''
		fail "删除 Ingress 失败，本地配置已恢复：$error"
	fi
	if [ "$managed_dns" = 1 ] && [ -n "$dns_id" ]; then
		if ! delete_owned_dns_record "$account" "$zone_id" "$dns_id" "$tunnel_id"; then
			error="$DNS_ERROR"
			rollback_route_transaction "删除 DNS 记录失败，所有更改已回滚：$error"
		fi
	fi
	uci -q set "$CONF.$tunnel.config_version=$NEW_CONFIG_VERSION"
	uci -q commit "$CONF"
	log_event info route "Deleted route $section"
	emit_message '穿透规则及其托管 DNS 已删除'
}

lease_lookup_cb() {
	local section="$1" mac ip
	config_get mac "$section" mac
	config_get ip "$section" ip
	mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
	if [ "$mac" = "$LEASE_MAC" ]; then
		LEASE_SECTION="$section"
	elif [ "$ip" = "$LEASE_IP" ]; then
		LEASE_IP_CONFLICT=1
	fi
}

reserve_device() {
	local name mac ip section
	name="$(request_value name)"
	mac="$(request_value mac | tr 'A-F' 'a-f')"
	ip="$(request_value ip)"
	if [ -z "$mac" ] || ! valid_mac "$mac"; then
		fail '创建静态租约必须提供有效的 MAC 地址'
	fi
	valid_ipv4 "$ip" || fail '静态租约 IPv4 地址无效'
	if [ -n "$name" ]; then
		printf '%s' "$name" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$' || fail '设备名只能包含字母、数字、点、下划线和连字符'
	fi
	LEASE_MAC="$mac"
	LEASE_IP="$ip"
	LEASE_SECTION=
	LEASE_IP_CONFLICT=0
	config_load dhcp
	config_foreach lease_lookup_cb host
	[ "$LEASE_IP_CONFLICT" -eq 0 ] || fail '该 IP 已分配给另一个静态租约'
	if [ -n "$LEASE_SECTION" ]; then
		section="$LEASE_SECTION"
	else
		section="$(uci -q add dhcp host)"
	fi
	uci -q set "dhcp.$section.mac=$mac"
	uci -q set "dhcp.$section.ip=$ip"
	if [ -n "$name" ]; then
		uci -q set "dhcp.$section.name=$name"
	else
		uci -q delete "dhcp.$section.name" 2>/dev/null || true
	fi
	uci -q commit dhcp || fail '保存 DHCP 静态租约失败'
	/etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
	log_event info device "Reserved $mac as $ip"
	emit_message '设备静态租约已保存'
}

test_origin() {
	local protocol ip port output connect_time http_code
	protocol="$(request_value protocol)"
	ip="$(request_value origin_ip)"
	port="$(request_value port)"
	valid_protocol "$protocol" || fail '源服务协议无效'
	valid_ipv4 "$ip" || fail '设备 IPv4 地址无效'
	valid_port "$port" || fail '源服务端口无效'
	if [ "$protocol" = http ] || [ "$protocol" = https ]; then
		output="$($CURL_BIN --silent --show-error --insecure --connect-timeout 4 --max-time 8 \
			--output /dev/null --write-out '%{time_connect}|%{http_code}' \
			"$protocol://$ip:$port/" 2>&1)" || fail "源服务连接失败：$output"
		connect_time="${output%%|*}"
		http_code="${output#*|}"
	else
		command -v nc >/dev/null 2>&1 || fail '系统缺少 nc，无法测试 TCP 端口'
		nc -w 4 "$ip" "$port" </dev/null >/dev/null 2>&1 || fail 'TCP 端口无法连接'
		connect_time=
		http_code=
	fi
	json_init
	json_add_boolean success 1
	json_add_string message '源服务连接正常'
	json_add_string connect_time "$connect_time"
	json_add_string http_code "$http_code"
	json_dump
	printf '\n'
}

save_settings() {
	local enabled interface loglevel
	enabled="$(request_bool enabled)"
	interface="$(request_value interface)"
	loglevel="$(request_value loglevel)"
	case "$interface" in ''|*[!A-Za-z0-9_.-]*) fail '网络接口名称无效' ;; esac
	valid_log_level "$loglevel" || fail '日志级别无效'
	uci -q set "$CONF.main=settings"
	uci -q set "$CONF.main.enabled=$enabled"
	uci -q set "$CONF.main.interface=$interface"
	uci -q set "$CONF.main.loglevel=$loglevel"
	uci -q commit "$CONF"
	if [ "$enabled" -eq 1 ]; then "$INIT" enable >/dev/null 2>&1 || true; else "$INIT" disable >/dev/null 2>&1 || true; fi
	reload_manager
	log_event info settings "Saved enabled=$enabled interface=$interface loglevel=$loglevel"
	emit_message '全局设置已保存'
}

restart_service() {
	"$INIT" restart >/dev/null 2>&1 || fail 'cloudflared 服务重启失败'
	log_event info service 'Restarted all tunnel instances'
	emit_message '所有 Tunnel 实例已重启'
}

show_logs() {
	local target="$1" log_file
	if [ "$target" = manager ]; then
		log_file="$MANAGER_LOG"
	else
		require_section_type "$target" tunnel
		log_file="$LOG_ROOT/$target.log"
	fi
	[ -f "$log_file" ] || return 0
	tail -n 300 "$log_file"
}

clear_log() {
	local target log_file
	target="$(request_value target)"
	if [ "$target" = manager ]; then
		log_file="$MANAGER_LOG"
	else
		require_section_type "$target" tunnel
		log_file="$LOG_ROOT/$target.log"
	fi
	: > "$log_file"
	chmod 0600 "$log_file"
	emit_message '日志已清空'
}

dispatch_request() {
	local operation
	REMOVE_REQUEST=1
	[ -f "$REQUEST_FILE" ] || fail '请求文件不存在'
	[ "$(wc -c < "$REQUEST_FILE")" -le 65536 ] || fail '请求内容过大'
	chmod 0600 "$REQUEST_FILE"
	operation="$(request_value operation)"
	acquire_lock
	case "$operation" in
		save_account) save_account ;;
		verify_account) verify_account ;;
		delete_account) delete_account ;;
		create_tunnel) create_tunnel ;;
		import_tunnel) import_tunnel ;;
		save_tunnel_settings) save_tunnel_settings ;;
		toggle_tunnel) toggle_tunnel ;;
		delete_tunnel) delete_tunnel ;;
		save_route) save_route ;;
		delete_route) delete_route ;;
		reserve_device) reserve_device ;;
		test_origin) test_origin ;;
		save_settings) save_settings ;;
		restart_service) restart_service ;;
		clear_log) clear_log ;;
		*) fail '不支持的操作' ;;
	esac
}

prepare_dirs
case "${1:-snapshot}" in
	snapshot) snapshot ;;
	zones) [ "$#" -eq 2 ] || fail '缺少账号参数'; list_zones "$2" ;;
	remote-tunnels) [ "$#" -eq 2 ] || fail '缺少账号参数'; list_remote_tunnels "$2" ;;
	logs) [ "$#" -eq 2 ] || fail '缺少日志参数'; show_logs "$2" ;;
	request) dispatch_request ;;
	*) fail '不支持的命令' ;;
esac
