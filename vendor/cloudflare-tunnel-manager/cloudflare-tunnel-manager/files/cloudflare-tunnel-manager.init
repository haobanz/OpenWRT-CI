#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/cloudflared
CONF=cloudflare-tunnel-manager
SECRET_ROOT=/etc/cloudflare-tunnel-manager/secrets/tunnels
RUNTIME_ROOT=/tmp/cloudflare-tunnel-manager
LOG_ROOT=/var/log/cloudflare-tunnel-manager

umask 077

append_value() {
	local value
	config_get value "$1" "$2" "${3:-}"
	[ -n "$value" ] && procd_append_param command "--${2//_/-}" "$value"
}

start_tunnel() {
	local section="$1"
	local enabled tunnel_id token_file log_file pid_file loglevel

	config_get_bool enabled "$section" enabled '0'
	[ "$enabled" -eq 1 ] || return 0
	config_get tunnel_id "$section" tunnel_id
	[ -n "$tunnel_id" ] || {
		logger -t cloudflare-tunnel-manager "Skipping $section: missing tunnel ID"
		return 0
	}

	token_file="$SECRET_ROOT/$section.token"
	[ -s "$token_file" ] || {
		logger -t cloudflare-tunnel-manager "Skipping $section: missing tunnel token"
		return 0
	}

	config_get loglevel main loglevel 'info'
	log_file="$LOG_ROOT/$section.log"
	pid_file="$RUNTIME_ROOT/$section.pid"
	rm -f "$pid_file"

	procd_open_instance "$section"
	procd_set_param command "$PROG" tunnel --no-autoupdate
	procd_append_param command --loglevel "$loglevel"
	procd_append_param command --logfile "$log_file"
	procd_append_param command --pidfile "$pid_file"
	append_value "$section" protocol
	append_value "$section" edge_ip_version
	append_value "$section" edge_bind_address
	append_value "$section" grace_period
	append_value "$section" retries
	append_value "$section" region
	append_value "$section" tag
	append_value "$section" metrics
	procd_append_param command run --token-file "$token_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	local enabled

	config_load "$CONF"
	config_get_bool enabled main enabled '1'
	[ "$enabled" -eq 1 ] || return 0
	[ -x "$PROG" ] || {
		logger -t cloudflare-tunnel-manager 'cloudflared is not installed'
		return 1
	}

	mkdir -p "$RUNTIME_ROOT" "$LOG_ROOT"
	chmod 0700 "$RUNTIME_ROOT" "$LOG_ROOT"
	config_foreach start_tunnel tunnel
}

stop_service() {
	rm -f "$RUNTIME_ROOT"/*.pid 2>/dev/null || true
}

service_triggers() {
	local interface

	procd_add_reload_trigger "$CONF"
	config_load "$CONF"
	config_get interface main interface 'wan'
	[ -n "$interface" ] && \
		procd_add_interface_trigger "interface.*.up" "$interface" \
		/etc/init.d/cloudflare-tunnel-manager restart
}
