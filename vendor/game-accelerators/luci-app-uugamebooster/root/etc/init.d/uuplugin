#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=15

PROG_DIR="/var/tmp/uu"
PROG="$PROG_DIR/uuplugin"
UU_CONF="$PROG_DIR/uu.conf"
UU_INFO="$PROG_DIR/h3c_info"

log_msg() {
	logger -t uuplugin "$*"
	echo "$*"
}

get_arch() {
	case "$(uname -m)" in
		aarch64|arm64) echo aarch64 ;;
		armv7*|armv8l) echo arm ;;
		mipsel|mipsle) echo mipsel ;;
		*) return 1 ;;
	esac
}

get_api_url() {
	case "$1" in
		aarch64) echo 'https://router.uu.163.com/api/plugin?type=h3c-nx30pro' ;;
		arm) echo 'https://router.uu.163.com/api/plugin?type=h3c-bx54' ;;
		mipsel) echo 'https://router.uu.163.com/api/plugin?type=jd-hr06' ;;
		*) return 1 ;;
	esac
}

download_plugin() {
	local arch api metadata plugin_url metadata_tail plugin_md5 backup_url
	local archive extract_dir actual_md5

	arch="$1"
	api="$(get_api_url "$arch")" || return 1
	metadata="$(curl --fail --location --silent --show-error \
		--connect-timeout 10 --max-time 30 -H 'Accept:text/plain' "$api")" || {
		log_msg "Unable to query the NetEase UU plugin API"
		return 1
	}
	metadata="$(printf '%s' "$metadata" | tr -d '\r\n')"

	plugin_url="${metadata%%,*}"
	metadata_tail="${metadata#*,}"
	plugin_md5="${metadata_tail%%,*}"
	backup_url="${metadata_tail#*,}"
	backup_url="${backup_url%%,*}"
	echo "$plugin_md5" | grep -Eq '^[0-9a-fA-F]{32}$' || {
		log_msg "The NetEase UU plugin API returned an invalid checksum"
		return 1
	}
	case "$plugin_url" in
		https://*) ;;
		*)
			log_msg "The NetEase UU plugin API returned a non-HTTPS URL"
			return 1
			;;
	esac

	archive="/tmp/uuplugin-archive.$$"
	extract_dir="/tmp/uuplugin-extract.$$"
	rm -f "$archive"
	rm -rf "$extract_dir"
	mkdir -m 0700 "$extract_dir" || return 1

	if ! curl --fail --location --silent --show-error --retry 2 \
		--connect-timeout 15 --max-time 180 -o "$archive" "$plugin_url"; then
		case "$backup_url" in
			https://*)
				curl --fail --location --silent --show-error --retry 2 \
					--connect-timeout 15 --max-time 180 -o "$archive" "$backup_url" || {
					rm -f "$archive"
					rm -rf "$extract_dir"
					return 1
				}
				;;
			*)
				rm -f "$archive"
				rm -rf "$extract_dir"
				return 1
				;;
		esac
	fi

	actual_md5="$(md5sum "$archive" | awk '{print $1}')"
	if [ "$actual_md5" != "$plugin_md5" ]; then
		log_msg "NetEase UU plugin checksum verification failed"
		rm -f "$archive"
		rm -rf "$extract_dir"
		return 1
	fi

	if tar -tzf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
		log_msg "The downloaded NetEase UU plugin archive contains unsafe paths"
		rm -f "$archive"
		rm -rf "$extract_dir"
		return 1
	fi
	if ! tar -xzf "$archive" -C "$extract_dir" || \
		[ ! -f "$extract_dir/uuplugin" ] || [ -L "$extract_dir/uuplugin" ] || \
		[ ! -f "$extract_dir/uu.conf" ] || [ -L "$extract_dir/uu.conf" ]; then
		log_msg "The downloaded NetEase UU plugin archive is incomplete"
		rm -f "$archive"
		rm -rf "$extract_dir"
		return 1
	fi

	chmod 0755 "$extract_dir/uuplugin"
	[ ! -f "$extract_dir/xuplugin-guardian" ] || \
		chmod 0755 "$extract_dir/xuplugin-guardian"
	rm -f "$archive"
	rm -rf "$PROG_DIR"
	mv "$extract_dir" "$PROG_DIR"
	log_msg "Installed the verified NetEase UU plugin runtime"
}

add_firewall_rules() {
	local enabled
	enabled="$(uci -q get uuplugin.@uuplugin[0].addfw)"
	[ "$enabled" = 1 ] || return 0

	uci -q batch <<-'EOF'
		set firewall.uuplugin=zone
		set firewall.uuplugin.name='UU'
		set firewall.uuplugin.input='ACCEPT'
		set firewall.uuplugin.output='ACCEPT'
		set firewall.uuplugin.forward='ACCEPT'
		set firewall.uuplugin.device='tun16+'
		set firewall.uuplugin_lan=forwarding
		set firewall.uuplugin_lan.src='lan'
		set firewall.uuplugin_lan.dest='UU'
	EOF
	uci -q commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
}

delete_firewall_rules() {
	local changed=0
	if uci -q get firewall.uuplugin >/dev/null; then
		uci -q delete firewall.uuplugin
		changed=1
	fi
	if uci -q get firewall.uuplugin_lan >/dev/null; then
		uci -q delete firewall.uuplugin_lan
		changed=1
	fi
	[ "$changed" = 1 ] || return 0
	uci -q commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
}

start_service() {
	local enabled arch model lan_mac version
	enabled="$(uci -q get uuplugin.@uuplugin[0].enabled)"
	[ -n "$enabled" ] || enabled=0
	[ "$enabled" = 1 ] || return 0

	if /etc/init.d/acc running >/dev/null 2>&1 || \
		pidof acc-gw.linux.arm64 acc-gw.linux.amd64 acc-gw.linux.arm acc-gw.linux.mipsle >/dev/null 2>&1; then
		log_msg "Refusing to start because Leigod Accelerator is already running"
		return 1
	fi

	arch="$(get_arch)" || {
		log_msg "Unsupported CPU architecture: $(uname -m)"
		return 1
	}
	if [ ! -x "$PROG" ] || [ ! -f "$UU_CONF" ]; then
		download_plugin "$arch" || return 1
	fi

	model="$(uci -q get uuplugin.@uuplugin[0].model)"
	[ -n "$model" ] || model='NN6000-v2'
	lan_mac="$(cat /sys/class/net/br-lan/address 2>/dev/null)"
	[ -n "$lan_mac" ] || {
		log_msg "Unable to read the br-lan MAC address"
		return 1
	}
	{
		echo "productname=$model"
		echo "ethaddr=$lan_mac"
		echo 'hardversion=VER.A'
		echo 'bootversion=100'
		echo "manucode=$lan_mac"
	} > "$UU_INFO"

	if pidof clash mihomo dae daed >/dev/null 2>&1; then
		log_msg "A proxy service is also running; use per-device bypass rules if traffic conflicts"
	fi
	version="$($PROG -v 2>/dev/null | awk -F 'version:' '{print $2}' | tr -d ' \n')"
	log_msg "Starting NetEase UU plugin${version:+ version $version}"

	procd_open_instance uuplugin
	procd_set_param command "$PROG" "$UU_CONF"
	procd_set_param limits core='unlimited'
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	add_firewall_rules
}

stop_service() {
	delete_firewall_rules
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger uuplugin
}
