#!/bin/sh

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@uuplugin[-1]
	add ucitrack uuplugin
	set ucitrack.@uuplugin[-1].init=uuplugin
	commit ucitrack
EOF
chmod +x /etc/init.d/uuplugin
/etc/init.d/uuplugin enable >/dev/null 2>&1 || true
rm -rf /tmp/luci-indexcache /tmp/luci-indexcache.* /tmp/luci-modulecache
exit 0
