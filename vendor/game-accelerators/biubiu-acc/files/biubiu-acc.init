#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

CONFIG='biubiu-acc'
SUPERVISOR='/usr/libexec/biubiu-acc-supervisor'
TRAFFIC='/usr/libexec/biubiu-acc-traffic'

start_service() {
	local enabled

	config_load "$CONFIG"
	config_get_bool enabled main manager_enabled 0
	[ "$enabled" -eq 1 ] || return 0
	[ -x "$SUPERVISOR" ] || {
		logger -t biubiu-acc 'supervisor is not installed'
		return 1
	}

	procd_open_instance manager
	procd_set_param command "$SUPERVISOR"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	[ -x "$TRAFFIC" ] || return 0
	"$TRAFFIC" stop >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
