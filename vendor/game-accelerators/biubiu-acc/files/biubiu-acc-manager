#!/bin/sh

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

CONFIG='biubiu-acc'
CLI='/usr/bin/biubiu-accctl'
INIT='/etc/init.d/biubiu-acc'
TRAFFIC='/usr/libexec/biubiu-acc-traffic'
CATALOG_FILE='/usr/share/biubiu-acc/game-catalog.json'
CONNTRACK_FILE='/proc/net/nf_conntrack'
RUNTIME_ROOT='/tmp/biubiu-acc'
REQUEST_FILE="$RUNTIME_ROOT/request.json"
LOCK_DIR="$RUNTIME_ROOT/control.lock"
STATE_FILE="$RUNTIME_ROOT/status.json"
LOG_ROOT='/var/log/biubiu-acc'
LOG_FILE="$LOG_ROOT/manager.log"
TEMP_PREFIX="$RUNTIME_ROOT/job.$$"
LOCK_HELD=0
REMOVE_REQUEST=0

umask 077

cleanup() {
	rm -f "$TEMP_PREFIX".* 2>/dev/null || true
	[ "$REMOVE_REQUEST" -eq 0 ] || rm -f "$REQUEST_FILE"
	[ "$LOCK_HELD" -eq 0 ] || rmdir "$LOCK_DIR" 2>/dev/null || true
}

terminate() {
	exit 1
}

trap cleanup EXIT
trap terminate INT TERM

prepare_dirs() {
	mkdir -p "$RUNTIME_ROOT" "$LOG_ROOT" /etc/biubiu-acc
	chmod 0700 "$RUNTIME_ROOT" "$LOG_ROOT" /etc/biubiu-acc
	[ ! -f "/etc/config/$CONFIG" ] || chmod 0600 "/etc/config/$CONFIG"
}

trim_log() {
	local size temp
	[ -f "$LOG_FILE" ] || return 0
	size="$(wc -c < "$LOG_FILE" 2>/dev/null || printf '0')"
	case "$size" in ''|*[!0-9]*) size=0 ;; esac
	[ "$size" -le 262144 ] && return 0
	temp="$TEMP_PREFIX.log"
	tail -c 131072 "$LOG_FILE" > "$temp" 2>/dev/null || return 0
	mv -f "$temp" "$LOG_FILE"
}

log_event() {
	local level="$1" action="$2" message="$3" clean
	clean="$(printf '%s' "$message" | tr '\r\n' '  ' | cut -c 1-240)"
	trim_log
	printf '%s\t%s\t%s\t%s\n' "$(date -Iseconds 2>/dev/null || date)" \
		"$level" "$action" "$clean" >> "$LOG_FILE"
	logger -t biubiu-acc "[$level] $action: $clean"
}

fail() {
	local message="$*"
	log_event error request "$message"
	printf '%s\n' "$message" >&2
	exit 1
}

emit_message() {
	json_init
	json_add_boolean success 1
	json_add_string message "$1"
	json_dump
	printf '\n'
}

bool_value() {
	case "$1" in 1|true|yes|on) printf '1\n' ;; *) printf '0\n' ;; esac
}

safe_text() {
	local value="$1" maximum="$2" length
	[ -n "$value" ] || return 1
	! printf '%s' "$value" | grep -q '[[:cntrl:]]' || return 1
	length="$(printf '%s' "$value" | wc -c)"
	[ "$length" -le "$maximum" ]
}

decimal_value() {
	local value="$1" maximum="$2" length
	[ -n "$value" ] || return 1
	case "$value" in *[!0-9]*) return 1 ;; esac
	length="$(printf '%s' "$value" | wc -c)"
	[ "$length" -le "$maximum" ]
}

valid_ipv4() (
	local octet
	set -f
	IFS=.
	# shellcheck disable=SC2086
	set -- $1
	[ "$#" -eq 4 ] || exit 1
	for octet in "$@"; do
		case "$octet" in ''|*[!0-9]*) exit 1 ;; esac
		[ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] || exit 1
	done
)

valid_mac() {
	[ -z "$1" ] || printf '%s' "$1" | grep -Eqi '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'
}

provider_domain_rules_from_nft() {
	local protocol="$1" domains rule ports domain_index set_name ips ip rules=''
	domains="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e "@.${protocol}Domains[*]" 2>/dev/null)"
	[ -n "$domains" ] || return 0
	domain_index=0
	for rule in $domains; do
		case "$rule" in
			*'|'*)
				ports="${rule#*|}"
				case "$ports" in ''|*[!0-9,*-]*) continue ;; esac
				domain_index=$((domain_index + 1))
				[ "$domain_index" -le 128 ] || break
				set_name="provider_domain_${protocol}_${domain_index}"
				ips="$(nft list set inet biubiu_acc "$set_name" 2>/dev/null |
					awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+(\.[0-9]+){3}$/) print $i }' |
					awk '!seen[$0]++')"
				for ip in $ips; do
					rules="${rules}${rules:+
}${ip}/32|${ports}"
				done
				;;
			*) continue ;;
		esac
	done
	printf '%s\n' "$rules"
}

valid_game_slug() {
	local value="$1" length
	case "$value" in ''|-*|*-|*[!a-z0-9-]*) return 1 ;; esac
	length="$(printf '%s' "$value" | wc -c)"
	[ "$length" -le 64 ]
}

catalog_has_game() {
	local game="$1"
	[ -f "$CATALOG_FILE" ] && [ ! -L "$CATALOG_FILE" ] || return 1
	jsonfilter -i "$CATALOG_FILE" -e '@.profiles[*].id' 2>/dev/null |
		grep -Fxq "$game"
}

print_selected_game() {
	valid_game_slug "$1" && printf '%s\n' "$1"
}

match_status_error() {
	json_init
	json_add_boolean available 0
	json_add_string error "$1"
	json_dump
	printf '\n'
}

json_field() {
	jsonfilter -s "$1" -e "@.$2" 2>/dev/null | head -n 1
}

uci_get() {
	uci -q get "$CONFIG.$1.$2" 2>/dev/null || printf '%s\n' "${3:-}"
}

request_value() {
	jsonfilter -i "$REQUEST_FILE" -e "@.$1" 2>/dev/null | head -n 1
}

request_values() {
	jsonfilter -i "$REQUEST_FILE" -e "@.$1[*]" 2>/dev/null
}

acquire_request() {
	local attempt=0 owner mode size
	while ! mkdir "$LOCK_DIR" 2>/dev/null; do
		attempt=$((attempt + 1))
		[ "$attempt" -lt 30 ] || fail '另一个 biubiu 操作仍在执行'
		usleep 100000 2>/dev/null || sleep 1
	done
	LOCK_HELD=1
	if [ ! -f "$REQUEST_FILE" ] || [ -L "$REQUEST_FILE" ]; then
		fail '请求文件不存在或不安全'
	fi
	owner="$(stat -c '%u' "$REQUEST_FILE" 2>/dev/null || printf 'invalid')"
	mode="$(stat -c '%a' "$REQUEST_FILE" 2>/dev/null || printf 'invalid')"
	size="$(wc -c < "$REQUEST_FILE" 2>/dev/null || printf '0')"
	[ "$owner" = 0 ] || fail '请求文件必须属于 root'
	[ "$mode" = 600 ] || fail '请求文件权限必须为 0600'
	case "$size" in ''|*[!0-9]*) fail '请求文件大小无效' ;; esac
	if [ "$size" -le 1 ] || [ "$size" -gt 16384 ]; then
		fail '请求文件大小无效'
	fi
	REMOVE_REQUEST=1
	jsonfilter -i "$REQUEST_FILE" -e '@.operation' >/dev/null 2>&1 || fail '请求 JSON 无效'
}

run_cli() {
	local action="$1" message
	shift
	if "$CLI" "$@" > "$TEMP_PREFIX.out" 2> "$TEMP_PREFIX.err"; then
		return 0
	fi
	message="$(tr '\r\n' '  ' < "$TEMP_PREFIX.err" | cut -c 1-240)"
	[ -n "$message" ] || message='客户端命令执行失败'
	log_event error "$action" "$message"
	printf '%s\n' "$message" >&2
	return 1
}

private_json_ready() {
	local path="$1" owner mode
	[ -f "$path" ] && [ ! -L "$path" ] || return 1
	owner="$(stat -c '%u' "$path" 2>/dev/null || printf 'invalid')"
	mode="$(stat -c '%a' "$path" 2>/dev/null || printf 'invalid')"
	[ "$owner" = 0 ] && [ "$mode" = 600 ]
}

runtime_expiry() {
	local path="$1" value expression minimum=0
	[ -f "$path" ] && [ ! -L "$path" ] || {
		printf '0\n'
		return 0
	}
	for expression in '@.channels[*].expiresAt' '@.outbounds[*].channels[*].expiresAt'; do
		for value in $(jsonfilter -i "$path" -e "$expression" 2>/dev/null); do
			case "$value" in ''|*[!0-9]*) continue ;; esac
			if [ "$value" -gt 100000000000 ] 2>/dev/null; then
				value=$((value / 1000))
			fi
			[ "$value" -gt 0 ] 2>/dev/null && [ "$value" -le 4102444800 ] 2>/dev/null || continue
			if [ "$minimum" -eq 0 ] || [ "$value" -lt "$minimum" ]; then
				minimum="$value"
			fi
		done
	done
	printf '%s\n' "$minimum"
}

runtime_is_expired() {
	local path="$1" expiry now
	expiry="$(runtime_expiry "$path")"
	case "$expiry" in ''|*[!0-9]*|0) return 1 ;; esac
	now="$(date +%s 2>/dev/null || printf '0')"
	case "$now" in ''|*[!0-9]*) return 1 ;; esac
	[ "$expiry" -le "$now" ] 2>/dev/null
}

runtime_json_ready() {
	local path="$1" schema signal_session_id
	private_json_ready "$path" || return 1
	schema="$(jsonfilter -i "$path" -e '@.schemaVersion' 2>/dev/null | head -n 1)"
	case "$schema" in 1|2) ;; *) return 1 ;; esac
	signal_session_id="$(jsonfilter -i "$path" -e '@.signalSessionId' 2>/dev/null | head -n 1)"
	[ -n "$signal_session_id" ] || return 1
	! printf '%s' "$signal_session_id" | grep -q '[[:cntrl:]]' || return 1
	runtime_is_expired "$path" && return 1
	return 0
}

invalidate_data_plane() {
	# Profile, channel authorization, and runtime are one consistency unit.
	# Never leave an older channel usable after account or game parameters change.
	[ -x "$TRAFFIC" ] && "$TRAFFIC" stop >/dev/null 2>&1 || true
	uci -q set "$CONFIG.main.acceleration_enabled=0"
	uci -q commit "$CONFIG" >/dev/null 2>&1 || true
	rm -f /etc/biubiu-acc/authorization.json \
		/etc/biubiu-acc/channel-ticket.json \
		/etc/biubiu-acc/pc-authorization.json \
		/etc/biubiu-acc/pc-channel-ticket.json \
		/etc/biubiu-acc/runtime.json
}

traffic_field() {
	jsonfilter -s "$1" -e "@.$2" 2>/dev/null | head -n 1
}

load_control_ids() {
	CONTROL_GAME_ID="$(uci_get main target_id '')"
	CONTROL_AREA_ID="$(uci_get main area_id '')"
	CONTROL_PLATFORM_ID="$(uci_get main platform_id '')"
	CONTROL_ACC_MODE="$(uci_get main acc_mode '')"
	if [ -z "$CONTROL_GAME_ID" ] && [ -z "$CONTROL_AREA_ID" ] &&
		[ -z "$CONTROL_PLATFORM_ID" ]; then
		config_load "$CONFIG"
		if config_list_foreach main selected_game print_selected_game |
			grep -qx 'counter-strike-2'; then
			CONTROL_GAME_ID=38780
			CONTROL_AREA_ID=146
			CONTROL_PLATFORM_ID=6
		fi
	fi
	decimal_value "$CONTROL_GAME_ID" 10 || fail '请先选择有效的加速游戏'
	decimal_value "$CONTROL_AREA_ID" 10 || fail '请先选择有效的区服'
	decimal_value "$CONTROL_PLATFORM_ID" 2 || fail '游戏平台无效'
	case "$CONTROL_ACC_MODE" in ''|3|4|5) ;; *) fail '加速模式无效' ;; esac
	[ "$CONTROL_PLATFORM_ID" -ge 1 ] 2>/dev/null &&
		[ "$CONTROL_PLATFORM_ID" -le 10 ] 2>/dev/null ||
		fail '平台 ID 必须在 1 到 10 之间'
}

start_control_context() {
	set -- "$CONTROL_GAME_ID" "$CONTROL_AREA_ID" "$CONTROL_PLATFORM_ID"
	[ -z "$CONTROL_ACC_MODE" ] || set -- "$@" "$CONTROL_ACC_MODE"
	run_cli pc-context-start pc-context-start "$@"
}

control_game_list() {
	run_cli pc-game-list pc-game-list || exit 1
	run_cli pc-game-catalog pc-game-catalog || exit 1
	log_event info control 'Game catalog refreshed from provider'
	cat "$TEMP_PREFIX.out"
}

control_game_search() {
	local keyword page size
	keyword="$(request_value keyword)"
	page="$(request_value page)"
	size="$(request_value size)"
	safe_text "$keyword" 128 || fail '搜索关键词无效'
	[ -n "$page" ] || page=1
	[ -n "$size" ] || size=12
	decimal_value "$page" 6 || fail '搜索页码无效'
	decimal_value "$size" 4 || fail '搜索数量无效'
	run_cli pc-game-search pc-game-search "$keyword" "$page" "$size" || exit 1
	run_cli pc-game-catalog pc-game-catalog || exit 1
	log_event info control 'Provider game search completed'
	cat "$TEMP_PREFIX.out"
}

control_game_options() {
	local game_id
	game_id="$(request_value game_id)"
	decimal_value "$game_id" 10 || fail '游戏 ID 无效'
	run_cli pc-game-map pc-game-map "$game_id" || exit 1
	run_cli pc-game-options pc-game-options "$game_id" || exit 1
	cat "$TEMP_PREFIX.out"
}

control_check_speedup() {
	load_control_ids
	run_cli pc-user-sync pc-user-sync || exit 1
	run_cli pc-game-map pc-game-map "$CONTROL_GAME_ID" || exit 1
	start_control_context || exit 1
	run_cli pc-check-speedup pc-check-speedup "$CONTROL_GAME_ID" \
		"$CONTROL_AREA_ID" || exit 1
	log_event info control 'Speedup entitlement checked'
	emit_message '已检查加速权益'
}

control_profile_fetch() {
	load_control_ids
	# The profile endpoint is only queried after the entitlement check so an
	# expired or unauthorized account cannot leave a misleading runtime state.
	run_cli pc-user-sync pc-user-sync || exit 1
	run_cli pc-game-map pc-game-map "$CONTROL_GAME_ID" || exit 1
	start_control_context || exit 1
	run_cli pc-check-speedup pc-check-speedup "$CONTROL_GAME_ID" \
		"$CONTROL_AREA_ID" || exit 1
	run_cli pc-profile-fetch pc-profile-fetch "$CONTROL_GAME_ID" \
		"$CONTROL_AREA_ID" || exit 1
	invalidate_data_plane
	run_cli pc-signal-login pc-signal-login "$CONTROL_GAME_ID" "$CONTROL_AREA_ID" \
		"$CONTROL_PLATFORM_ID" || exit 1
	run_cli pc-runtime-prepare pc-runtime-prepare || exit 1
	log_event info control 'Profile, channel authorization, and runtime refreshed'
	emit_message '节点配置已获取，数据通道已授权，运行时配置已准备'
}

control_signal_login() {
	load_control_ids
	private_json_ready /etc/biubiu-acc/pc-profile.json ||
		fail '请先获取节点配置'
	private_json_ready /etc/biubiu-acc/pc-context.json ||
		fail '加速上下文不存在，请重新获取节点配置'
	invalidate_data_plane
	run_cli pc-signal-login pc-signal-login "$CONTROL_GAME_ID" "$CONTROL_AREA_ID" \
		"$CONTROL_PLATFORM_ID" || exit 1
	run_cli pc-runtime-prepare pc-runtime-prepare || exit 1
	log_event info control 'Data channel authorization completed'
	emit_message '数据通道授权成功，运行时配置已更新'
}

control_channel_renew() {
	load_control_ids
	private_json_ready /etc/biubiu-acc/pc-profile.json ||
		fail '请先获取节点配置'
	private_json_ready /etc/biubiu-acc/pc-authorization.json ||
		fail '请先登录数据通道'
	run_cli pc-channel-renew pc-channel-renew "$CONTROL_GAME_ID" "$CONTROL_AREA_ID" \
		"$CONTROL_PLATFORM_ID" || exit 1
	run_cli pc-runtime-prepare pc-runtime-prepare || exit 1
	reload_data_plane_if_enabled || exit 1
	log_event info control 'Data channel tickets renewed'
	emit_message '数据通道已续期，运行时配置已更新'
}

reload_data_plane_if_enabled() {
	local error message
	[ "$(bool_value "$(uci_get main acceleration_enabled 0)")" -eq 1 ] || return 0
	error="$TEMP_PREFIX.reload.err"
	if "$TRAFFIC" reload > "$TEMP_PREFIX.reload.out" 2> "$error"; then
		rm -f "$TEMP_PREFIX.reload.out" "$error"
		return 0
	fi
	message="$(tr '\r\n' '  ' < "$error" | cut -c 1-240)"
	[ -n "$message" ] || message='运行中的数据通道 reload 失败，supervisor 将自动重试'
	log_event error acceleration "$message"
	rm -f "$TEMP_PREFIX.reload.out" "$error"
	printf '%s\n' "$message" >&2
	return 1
}

control_runtime_prepare() {
	private_json_ready /etc/biubiu-acc/pc-profile.json || fail '节点配置尚未获取'
	private_json_ready /etc/biubiu-acc/pc-authorization.json || fail '数据通道尚未授权'
	run_cli pc-runtime-prepare pc-runtime-prepare || exit 1
	reload_data_plane_if_enabled || exit 1
	log_event info control 'Runtime configuration materialized'
	emit_message '运行时通道配置已生成'
}

control_acceleration_action() {
	local action message
	action="$(request_value action)"
	case "$action" in
		start|restart)
			private_json_ready /etc/biubiu-acc/session.json || fail '账号尚未登录'
			private_json_ready /etc/biubiu-acc/acceleration-key.json || fail '加速业务公钥尚未配置'
			private_json_ready /etc/biubiu-acc/pc-profile.json || fail '请先获取节点配置'
			private_json_ready /etc/biubiu-acc/pc-authorization.json || fail '请先登录数据通道'
			run_cli pc-runtime-prepare pc-runtime-prepare || exit 1
			if [ "$action" = restart ]; then
				"$TRAFFIC" stop >/dev/null 2>&1 || true
			fi
			uci -q set "$CONFIG.main.acceleration_enabled=1"
			uci -q commit "$CONFIG" || fail '保存加速开关失败'
			if "$TRAFFIC" start > "$TEMP_PREFIX.traffic.out" 2> "$TEMP_PREFIX.traffic.err"; then
				log_event info acceleration "$action completed"
				emit_message '加速已启动，已接管所选游戏流量'
				return 0
			fi
			uci -q set "$CONFIG.main.acceleration_enabled=0"
			uci -q commit "$CONFIG" >/dev/null 2>&1 || true
			message="$(tr '\r\n' '  ' < "$TEMP_PREFIX.traffic.err" | cut -c 1-240)"
			[ -n "$message" ] || message='数据通道启动失败，请查看 engine.log'
			log_event error acceleration "$message"
			printf '%s\n' "$message" >&2
			exit 1
			;;
		stop)
			uci -q set "$CONFIG.main.acceleration_enabled=0"
			uci -q commit "$CONFIG" || fail '保存加速开关失败'
			"$TRAFFIC" stop >/dev/null 2>&1 || fail '停止流量接管失败'
			log_event info acceleration 'stop completed'
			emit_message '加速已停止，流量接管规则已清理'
			;;
		*) fail '加速操作无效' ;;
	esac
}

service_running() {
	local pid command_line
	pid="$(jsonfilter -i "$STATE_FILE" -e '@.pid' 2>/dev/null | head -n 1)"
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ -r "/proc/$pid/cmdline" ] || return 1
	command_line="$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
	case "$command_line" in *'/usr/libexec/biubiu-acc-supervisor'*) return 0 ;; *) return 1 ;; esac
}

snapshot() {
	local version session_json key_json authenticated refreshable method cookies cookie_transport_ready
	local key_cached key_version key_bits fingerprint manager_enabled running phase message
	local acceleration_enabled openclash_mode profile_cached authorization_cached runtime_cached
	local runtime_expired
	local data_plane_ready control_api data_channel traffic_steering automatic_matching
	local provider_tcp_rules provider_udp_rules provider_tcp_domains provider_udp_domains
	local provider_rules_available provider_domain_rules_available route_rules_available
	local traffic_json traffic_active traffic_pid traffic_message
	local scope selected_games selected_game_count game
	local target_name target_ip target_mac target_id area_id platform_id log_level
	local game_name area_name acc_mode
	local pid rss uptime_seconds process_start boot_seconds clock_ticks

	version="$($CLI version 2>/dev/null | awk '{print $2; exit}')"
	session_json="$($CLI session-status 2>/dev/null || printf '{"authenticated":false,"refreshable":false,"method":"none","cookieCount":0,"cookieTransportReady":false}')"
	key_json="$($CLI acc-key-status 2>/dev/null || printf '{"cached":false}')"
	authenticated="$(json_field "$session_json" authenticated)"
	refreshable="$(json_field "$session_json" refreshable)"
	method="$(json_field "$session_json" method)"
	cookies="$(json_field "$session_json" cookieCount)"
	cookie_transport_ready="$(json_field "$session_json" cookieTransportReady)"
	key_cached="$(json_field "$key_json" cached)"
	key_version="$(json_field "$key_json" keyVersion)"
	key_bits="$(json_field "$key_json" rsaBits)"
	fingerprint="$(json_field "$key_json" fingerprintSha256)"
	manager_enabled="$(uci_get main manager_enabled 0)"
	scope="$(uci_get main scope lan)"
	case "$scope" in lan|device) ;; *) scope='lan' ;; esac
	config_load "$CONFIG"
	selected_games="$(config_list_foreach main selected_game print_selected_game)"
	selected_game_count="$(printf '%s\n' "$selected_games" | awk 'NF { count++ } END { print count + 0 }')"
	target_name="$(uci_get main target_name '')"
	target_ip="$(uci_get main target_ip '')"
	target_mac="$(uci_get main target_mac '')"
	target_id="$(uci_get main target_id '')"
	area_id="$(uci_get main area_id '')"
	platform_id="$(uci_get main platform_id '')"
	game_name="$(uci_get main game_name '')"
	area_name="$(uci_get main area_name '')"
	acc_mode="$(uci_get main acc_mode '')"
	log_level="$(uci_get main log_level info)"
	acceleration_enabled="$(uci_get main acceleration_enabled 0)"
	openclash_mode="$(uci_get main openclash_mode exclusive)"
	case "$openclash_mode" in exclusive) ;; *) openclash_mode='exclusive' ;; esac
	profile_cached=0
	authorization_cached=0
	runtime_cached=0
	runtime_expired=0
	private_json_ready /etc/biubiu-acc/pc-profile.json && profile_cached=1
	private_json_ready /etc/biubiu-acc/pc-authorization.json && authorization_cached=1
	private_json_ready /etc/biubiu-acc/runtime.json && \
		runtime_is_expired /etc/biubiu-acc/runtime.json && runtime_expired=1
	runtime_json_ready /etc/biubiu-acc/runtime.json && runtime_cached=1
	provider_tcp_rules=''
	provider_udp_rules=''
	provider_tcp_domains=''
	provider_udp_domains=''
	provider_rules_available=0
	provider_domain_rules_available=0
	if [ "$runtime_cached" -eq 1 ]; then
		provider_tcp_rules="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e '@.tcpRules[*]' 2>/dev/null)"
		provider_udp_rules="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e '@.udpRules[*]' 2>/dev/null)"
		provider_tcp_domains="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e '@.tcpDomains[*]' 2>/dev/null)"
		provider_udp_domains="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e '@.udpDomains[*]' 2>/dev/null)"
		[ -n "$provider_tcp_domains$provider_udp_domains" ] && provider_domain_rules_available=1
		[ -n "$provider_tcp_rules$provider_udp_rules" ] && provider_rules_available=1
		[ "$provider_domain_rules_available" -eq 1 ] && provider_rules_available=1
	fi
	route_rules_available=0
	for game in $selected_games; do
		case "$game" in
			steam|counter-strike-2) route_rules_available=1 ;;
		esac
	done
	[ "$provider_rules_available" -eq 1 ] && route_rules_available=1
	traffic_json="$($TRAFFIC status 2>/dev/null || printf '{"accelerating":false}')"
	traffic_active="$(traffic_field "$traffic_json" accelerating)"
	traffic_pid="$(traffic_field "$traffic_json" pid)"
	traffic_message="$(traffic_field "$traffic_json" message)"
	running=0
	pid=0
	rss=0
	uptime_seconds=0
	if service_running; then
		running=1
		pid="$(jsonfilter -i "$STATE_FILE" -e '@.pid' 2>/dev/null | head -n 1)"
		rss="$(awk '$1 == "VmRSS:" { print $2; exit }' "/proc/$pid/status" 2>/dev/null)"
		process_start="$(awk '{ print $22; exit }' "/proc/$pid/stat" 2>/dev/null)"
		boot_seconds="$(awk '{ print int($1); exit }' /proc/uptime 2>/dev/null)"
		clock_ticks="$(getconf CLK_TCK 2>/dev/null || printf '100')"
		case "$process_start:$boot_seconds:$clock_ticks" in *[!0-9:]*|*':0') ;; *)
			uptime_seconds=$((boot_seconds - process_start / clock_ticks))
			[ "$uptime_seconds" -ge 0 ] || uptime_seconds=0
		;; esac
	fi
	case "$cookies" in ''|*[!0-9]*) cookies=0 ;; esac
	case "$key_version" in ''|*[!0-9]*) key_version=0 ;; esac
	case "$key_bits" in ''|*[!0-9]*) key_bits=0 ;; esac
	case "$pid" in ''|*[!0-9]*) pid=0 ;; esac
	case "$rss" in ''|*[!0-9]*) rss=0 ;; esac
	case "$traffic_pid" in ''|*[!0-9]*) traffic_pid=0 ;; esac
	traffic_active="$(bool_value "$traffic_active")"
	acceleration_enabled="$(bool_value "$acceleration_enabled")"
	data_plane_ready=0
	[ "$profile_cached" -eq 1 ] && [ "$authorization_cached" -eq 1 ] && \
		[ "$runtime_cached" -eq 1 ] && [ -x /usr/bin/biubiu-accd ] && data_plane_ready=1
	[ -x "$CLI" ] && control_api=1 || control_api=0
	[ -x /usr/bin/biubiu-accd ] && data_channel=1 || data_channel=0
	[ -x "$TRAFFIC" ] && command -v nft >/dev/null 2>&1 && traffic_steering=1 || traffic_steering=0
	automatic_matching=1

	if [ "$(bool_value "$authenticated")" -ne 1 ]; then
		phase='account_required'
		message='账号尚未登录'
	elif [ "$selected_game_count" -eq 0 ] && [ -z "$target_id" ]; then
		phase='game_required'
		message='尚未选择加速游戏'
	elif [ "$scope" = device ] && [ -z "$target_ip" ]; then
		phase='target_required'
		message='尚未选择加速设备'
	elif [ "$(bool_value "$key_cached")" -ne 1 ]; then
		phase='key_required'
		message='加速业务公钥尚未配置'
	elif [ "$profile_cached" -ne 1 ]; then
		phase='profile_required'
		message='尚未获取节点配置'
	elif [ "$authorization_cached" -ne 1 ]; then
		phase='channel_required'
		message='数据通道尚未授权'
	elif [ "$runtime_cached" -ne 1 ] && [ "$runtime_expired" -eq 1 ]; then
		phase='runtime_expired'
		message='数据通道授权已过期，正在等待续期'
	elif [ "$runtime_cached" -ne 1 ]; then
		phase='runtime_required'
		message='运行时通道配置尚未生成'
	elif [ "$route_rules_available" -ne 1 ]; then
		phase='rules_required'
		message='当前配置没有可接管的游戏规则，请重新获取节点配置或选择内置游戏'
	elif [ "$traffic_active" -eq 1 ]; then
		phase='accelerating'
		message='数据通道运行中，已接管所选游戏流量'
	elif [ "$acceleration_enabled" -eq 1 ]; then
		phase='traffic_error'
		message="${traffic_message:-数据通道未运行，请查看 engine.log}"
	else
		phase='ready'
		message='授权通道已准备，可以启动流量接管'
	fi

	json_init
	json_add_string version "${version:-未安装}"
	json_add_boolean manager_enabled "$(bool_value "$manager_enabled")"
	json_add_boolean manager_running "$running"
	json_add_boolean accelerating "$traffic_active"
	json_add_boolean acceleration_enabled "$acceleration_enabled"
	json_add_boolean data_plane_ready "$data_plane_ready"
	json_add_boolean route_rules_available "$route_rules_available"
	json_add_string phase "$phase"
	json_add_string phase_message "$message"
	json_add_int pid "$pid"
	json_add_int rss_kb "$rss"
	json_add_int uptime_seconds "$uptime_seconds"
	json_add_object traffic
	json_add_boolean accelerating "$traffic_active"
	json_add_int pid "$traffic_pid"
	json_add_string message "${traffic_message:-}"
	json_close_object
	json_add_object data_plane
	json_add_boolean profile_cached "$profile_cached"
	json_add_boolean authorization_cached "$authorization_cached"
	json_add_boolean runtime_cached "$runtime_cached"
	json_add_boolean runtime_expired "$runtime_expired"
	json_add_boolean provider_rules_available "$provider_rules_available"
	json_add_boolean provider_domain_rules_available "$provider_domain_rules_available"
	json_add_boolean ready "$data_plane_ready"
	json_close_object
	json_add_object session
	json_add_boolean authenticated "$(bool_value "$authenticated")"
	json_add_boolean refreshable "$(bool_value "$refreshable")"
	json_add_string method "${method:-none}"
	json_add_int cookie_count "$cookies"
	json_add_boolean cookie_transport_ready "$(bool_value "$cookie_transport_ready")"
	json_close_object
	json_add_object acceleration_key
	json_add_boolean cached "$(bool_value "$key_cached")"
	json_add_int key_version "$key_version"
	json_add_int rsa_bits "$key_bits"
	json_add_string fingerprint_sha256 "$fingerprint"
	json_close_object
	json_add_object config
	json_add_string scope "$scope"
	json_add_array selected_games
	for game in $selected_games; do
		json_add_string '' "$game"
	done
	json_close_array
	json_add_string target_name "$target_name"
	json_add_string target_ip "$target_ip"
	json_add_string target_mac "$target_mac"
	json_add_string target_id "$target_id"
	json_add_string area_id "$area_id"
	json_add_string platform_id "$platform_id"
	json_add_string game_name "$game_name"
	json_add_string area_name "$area_name"
	json_add_string acc_mode "$acc_mode"
	json_add_string log_level "$log_level"
	json_add_boolean acceleration_enabled "$acceleration_enabled"
	json_add_string openclash_mode "$openclash_mode"
	json_close_object
	json_add_object capabilities
	json_add_boolean account_login 1
	json_add_boolean profile_storage 1
	json_add_boolean builtin_catalog 1
	json_add_boolean bolt_v3_codec 1
	json_add_boolean automatic_matching "$automatic_matching"
	json_add_boolean control_api "$control_api"
	json_add_boolean data_channel "$data_channel"
	json_add_boolean traffic_steering "$traffic_steering"
	json_close_object
	json_dump
	printf '\n'
}

show_catalog() {
	if [ ! -f "$CATALOG_FILE" ] || [ -L "$CATALOG_FILE" ]; then
		printf 'game catalog is not installed\n' >&2
		return 1
	fi
	jsonfilter -i "$CATALOG_FILE" -e '@.schema_version' >/dev/null 2>&1 || {
		printf 'game catalog is invalid\n' >&2
		return 1
	}
	cat "$CATALOG_FILE"
}

match_status() {
	local scope selected_games game target_ip lan_cidr tcp_ports udp_ports
	local has_steam=0 has_cs2=0
	local matches kind protocol source destination port packets bytes hints_available
	local flow_count total_packets total_bytes sample_truncated
	local traffic_json traffic_active data_plane_ready provider_tcp_rules provider_udp_rules
	local provider_tcp_domains provider_udp_domains provider_rules_available
	local provider_tcp_domain_rules provider_udp_domain_rules provider_domain_rules_available

	scope="$(uci_get main scope lan)"
	case "$scope" in lan|device) ;; *) scope='lan' ;; esac
	config_load "$CONFIG"
	selected_games="$(config_list_foreach main selected_game print_selected_game)"
	target_ip="$(uci_get main target_ip '')"
	traffic_json="$($TRAFFIC status 2>/dev/null || printf '{"accelerating":false}')"
	traffic_active="$(bool_value "$(traffic_field "$traffic_json" accelerating)")"
	data_plane_ready=0
	private_json_ready /etc/biubiu-acc/pc-profile.json && \
	private_json_ready /etc/biubiu-acc/pc-authorization.json && \
	runtime_json_ready /etc/biubiu-acc/runtime.json && \
	[ -x /usr/bin/biubiu-accd ] && data_plane_ready=1
	provider_tcp_rules=''
	provider_udp_rules=''
	provider_tcp_domains=''
	provider_udp_domains=''
	provider_tcp_domain_rules=''
	provider_udp_domain_rules=''
	provider_rules_available=0
	provider_domain_rules_available=0
	if runtime_json_ready /etc/biubiu-acc/runtime.json; then
		provider_tcp_rules="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e '@.tcpRules[*]' 2>/dev/null)"
		provider_udp_rules="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e '@.udpRules[*]' 2>/dev/null)"
		provider_tcp_domains="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e '@.tcpDomains[*]' 2>/dev/null)"
		provider_udp_domains="$(jsonfilter -i /etc/biubiu-acc/runtime.json -e '@.udpDomains[*]' 2>/dev/null)"
		provider_tcp_domain_rules="$(provider_domain_rules_from_nft tcp)"
		provider_udp_domain_rules="$(provider_domain_rules_from_nft udp)"
		[ -n "$provider_tcp_domain_rules" ] && provider_tcp_rules="${provider_tcp_rules}${provider_tcp_rules:+
}${provider_tcp_domain_rules}"
		[ -n "$provider_udp_domain_rules" ] && provider_udp_rules="${provider_udp_rules}${provider_udp_rules:+
}${provider_udp_domain_rules}"
		[ -n "$provider_tcp_domains$provider_udp_domains" ] && provider_domain_rules_available=1
		[ "$provider_domain_rules_available" -eq 1 ] && provider_rules_available=1
		[ -n "$provider_tcp_rules$provider_udp_rules" ] && provider_rules_available=1
	fi
	if [ "$scope" = device ] && ! valid_ipv4 "$target_ip"; then
		match_status_error '指定设备地址无效或尚未配置'
		return 0
	fi
	if [ ! -r "$CONNTRACK_FILE" ] || [ -L "$CONNTRACK_FILE" ]; then
		match_status_error '内核连接跟踪表不可用，请安装 conntrack 支持'
		return 0
	fi

	# Keep automatic hints limited to the bounded built-in profiles. Provider
	# profiles without local port hints remain visible but are not guessed here.
	for game in $selected_games; do
		case "$game" in
			steam)
				has_steam=1
				;;
			counter-strike-2)
				has_cs2=1
				;;
		esac
	done
	tcp_ports=''
	udp_ports=''
	if [ "$has_steam" -eq 1 ] || [ "$has_cs2" -eq 1 ]; then
		tcp_ports='27015-27050'
	fi
	if [ "$has_steam" -eq 1 ]; then
		udp_ports='3478,4379-4380,27000-27250'
	elif [ "$has_cs2" -eq 1 ]; then
		udp_ports='27000-27250'
	fi
	lan_cidr="$(ip -4 addr show br-lan 2>/dev/null | awk '/inet / { print $2; exit }')"
	if [ -z "$lan_cidr" ]; then
		match_status_error '无法读取 br-lan 的 IPv4 网络'
		return 0
	fi

	matches="$TEMP_PREFIX.matches"
	awk -v scope="$scope" -v target="$target_ip" -v lan_cidr="$lan_cidr" \
		-v tcp_ports="$tcp_ports" -v udp_ports="$udp_ports" \
		-v provider_tcp_rules="$provider_tcp_rules" -v provider_udp_rules="$provider_udp_rules" '
	function ip_number(text, parts, count, octet, number) {
		count = split(text, parts, ".")
		if (count != 4)
			return -1
		number = 0
		for (octet = 1; octet <= 4; octet++) {
			if (parts[octet] !~ /^[0-9]+$/ || parts[octet] < 0 || parts[octet] > 255)
				return -1
			number = number * 256 + parts[octet]
		}
		return number
	}
	function in_lan(address, cidr, network_parts, prefix, address_number, network_number, block, address_parts, network_address_parts) {
		prefix = split(cidr, network_parts, "/") == 2 ? network_parts[2] : -1
		if (prefix < 0 || prefix > 32)
			return 0
		address_number = ip_number(address, address_parts)
		network_number = ip_number(network_parts[1], network_address_parts)
		if (address_number < 0 || network_number < 0)
			return 0
		block = 2 ^ (32 - prefix)
		return int(address_number / block) == int(network_number / block)
	}
	function port_in_list(value, specs, list, count, item, bounds) {
		if (value !~ /^[0-9]+$/ || specs == "")
			return 0
		count = split(specs, list, ",")
		for (item = 1; item <= count; item++) {
			if (index(list[item], "-") > 0) {
				split(list[item], bounds, "-")
				if (value + 0 >= bounds[1] && value + 0 <= bounds[2])
					return 1
			} else if (value + 0 == list[item] + 0) {
				return 1
			}
		}
		return 0
	}
	function route_matches(address, port, specs, entries, count, item, separator, cidr, ports) {
		if (specs == "")
			return 0
		count = split(specs, entries, "\n")
		for (item = 1; item <= count; item++) {
			if (entries[item] == "")
				continue
			separator = index(entries[item], "|")
			if (separator <= 1)
				continue
			cidr = substr(entries[item], 1, separator - 1)
			ports = substr(entries[item], separator + 1)
			if (in_lan(address, cidr) && (ports == "*" || port_in_list(port, ports)))
				return 1
		}
		return 0
	}
	$1 == "ipv4" {
		protocol = $3
		source = destination = port = packets = bytes = ""
		for (field = 1; field <= NF; field++) {
			if (source == "" && $field ~ /^src=/)
				source = substr($field, 5)
			else if (destination == "" && $field ~ /^dst=/)
				destination = substr($field, 5)
			else if (port == "" && $field ~ /^dport=/)
				port = substr($field, 7)
			else if (packets == "" && $field ~ /^packets=/)
				packets = substr($field, 9)
			else if (bytes == "" && $field ~ /^bytes=/)
				bytes = substr($field, 7)
		}
		if (source == "" || destination == "" || port == "")
			next
		if (scope == "device" && source != target)
			next
		if (scope == "lan" && !in_lan(source, lan_cidr))
			next
		if ((protocol == "tcp" &&
			(port_in_list(port, tcp_ports) || route_matches(destination, port, provider_tcp_rules))) ||
			(protocol == "udp" &&
			(port_in_list(port, udp_ports) || route_matches(destination, port, provider_udp_rules)))) {
			matched++
			total_packets += packets + 0
			total_bytes += bytes + 0
			if (sample < 64) {
				printf "FLOW\t%s\t%s\t%s\t%s\t%s\t%s\n", protocol,
					source, destination, port, packets + 0, bytes + 0
				sample++
			} else {
				sample_truncated = 1
			}
		}
	}
	END {
		printf "SUMMARY\t%d\t%d\t%d\t%d\n", matched + 0,
			total_packets + 0, total_bytes + 0, sample_truncated + 0
	}
	' "$CONNTRACK_FILE" > "$matches" 2>/dev/null || {
		rm -f "$matches"
		match_status_error '读取内核连接跟踪表失败'
		return 0
	}

	flow_count=0
	total_packets=0
	total_bytes=0
	sample_truncated=0
	json_init
	json_add_boolean available 1
	json_add_string scope "$scope"
	json_add_array selected_games
	for game in $selected_games; do
		json_add_string '' "$game"
	done
	json_close_array
	json_add_array tcp_ports
	for port in $(printf '%s' "$tcp_ports" | tr ',' ' '); do
		json_add_string '' "$port"
	done
	json_close_array
	json_add_array udp_ports
	for port in $(printf '%s' "$udp_ports" | tr ',' ' '); do
		json_add_string '' "$port"
	done
	json_close_array
	if [ -n "$tcp_ports$udp_ports" ] || [ "$provider_rules_available" -eq 1 ]; then
		hints_available=1
	else
		hints_available=0
	fi
	json_add_boolean hints_available "$hints_available"
	json_add_array flows
	while IFS="$(printf '\t')" read -r kind protocol source destination port packets bytes; do
		case "$kind" in
			FLOW)
				json_add_object ''
				json_add_string protocol "$protocol"
				json_add_string source_ip "$source"
				json_add_string destination_ip "$destination"
				json_add_int destination_port "$port"
				json_add_int packets "$packets"
				json_add_int bytes "$bytes"
				json_close_object
				;;
			SUMMARY)
				flow_count="$protocol"
				total_packets="$source"
				total_bytes="$destination"
				sample_truncated="$port"
				;;
			esac
	done < "$matches"
	json_close_array
	case "$flow_count" in ''|*[!0-9]*) flow_count=0 ;; esac
	case "$total_packets" in ''|*[!0-9]*) total_packets=0 ;; esac
	case "$total_bytes" in ''|*[!0-9]*) total_bytes=0 ;; esac
	case "$sample_truncated" in 1) ;; *) sample_truncated=0 ;; esac
	json_add_int flow_count "$flow_count"
	json_add_int packets "$total_packets"
	json_add_int bytes "$total_bytes"
	json_add_boolean sample_truncated "$sample_truncated"
	json_add_boolean data_plane_ready "$data_plane_ready"
	json_add_boolean provider_rules_available "$provider_rules_available"
	json_add_boolean provider_domain_rules_available "$provider_domain_rules_available"
	json_add_boolean traffic_steering "$traffic_active"
	json_dump
	printf '\n'
	rm -f "$matches"
}

save_config() {
	local scope requested_games selected_games game game_count
	local target_name target_ip target_mac target_id area_id platform_id log_level openclash_mode
	local old_scope old_selected_games old_target_ip old_target_id old_area_id old_platform_id
	local old_openclash_mode data_plane_changed
	local game_name area_name acc_mode old_acc_mode selection_changed
	config_load "$CONFIG"
	old_scope="$(uci_get main scope lan)"
	old_selected_games="$(config_list_foreach main selected_game print_selected_game)"
	old_target_ip="$(uci_get main target_ip '')"
	old_target_id="$(uci_get main target_id '')"
	old_area_id="$(uci_get main area_id '')"
	old_platform_id="$(uci_get main platform_id '')"
	old_acc_mode="$(uci_get main acc_mode '')"
	game_name="$(uci_get main game_name '')"
	area_name="$(uci_get main area_name '')"
	old_openclash_mode="$(uci_get main openclash_mode exclusive)"
	scope="$(request_value scope)"
	requested_games="$(request_values selected_games)"
	target_name="$(request_value target_name)"
	target_ip="$(request_value target_ip)"
	target_mac="$(request_value target_mac)"
	target_id="$(request_value target_id)"
	area_id="$(request_value area_id)"
	platform_id="$(request_value platform_id)"
	acc_mode="$(request_value acc_mode)"
	log_level="$(request_value log_level)"
	openclash_mode="$(request_value openclash_mode)"
	[ -n "$openclash_mode" ] || openclash_mode="$(uci_get main openclash_mode exclusive)"
	case "$scope" in lan|device) ;; *) fail '加速范围无效' ;; esac
	selected_games=''
	game_count=0
	for game in $requested_games; do
		valid_game_slug "$game" || fail '游戏选择无效'
		catalog_has_game "$game" || fail '游戏不在内置目录中'
		case " $selected_games " in *" $game "*) continue ;; esac
		game_count=$((game_count + 1))
		[ "$game_count" -le 16 ] || fail '最多选择 16 个游戏'
		selected_games="${selected_games}${selected_games:+ }$game"
	done
	[ -z "$target_name" ] || safe_text "$target_name" 64 || fail '设备名称无效'
	[ -z "$target_ip" ] || valid_ipv4 "$target_ip" || fail '设备 IPv4 地址无效'
	valid_mac "$target_mac" || fail '设备 MAC 地址无效'
	[ -z "$target_id" ] || decimal_value "$target_id" 20 || fail '游戏 ID 必须是数字'
	[ -z "$area_id" ] || decimal_value "$area_id" 20 || fail '区服 ID 必须是数字'
	[ -z "$platform_id" ] || decimal_value "$platform_id" 20 || fail '平台 ID 必须是数字'
	case "$acc_mode" in ''|3|4|5) ;; *) fail '加速模式无效' ;; esac
	case "$log_level" in debug|info|warn|error) ;; *) fail '日志级别无效' ;; esac
	case "$openclash_mode" in exclusive) ;; *) fail 'OpenClash 冲突策略无效' ;; esac
	selection_changed=0
	if [ "$old_target_id" != "$target_id" ] || [ "$old_area_id" != "$area_id" ] ||
		[ "$old_platform_id" != "$platform_id" ] || [ "$old_acc_mode" != "$acc_mode" ]; then
		selection_changed=1
	fi
	if [ "$selection_changed" -eq 1 ] ||
		{ [ -z "$game_name" ] && [ -n "$(request_value game_name)" ]; }; then
		game_name=''
		area_name=''
		if [ -n "$target_id$area_id$platform_id$acc_mode" ]; then
			[ -n "$target_id" ] && [ -n "$area_id" ] && [ -n "$platform_id" ] ||
				fail '游戏、区服和平台必须一起选择'
			run_cli pc-game-map pc-game-map "$target_id" || exit 1
			set -- "$target_id" "$area_id" "$platform_id"
			[ -z "$acc_mode" ] || set -- "$@" "$acc_mode"
			run_cli pc-game-selection pc-game-selection "$@" || exit 1
			game_name="$(jsonfilter -i "$TEMP_PREFIX.out" -e '@.game_name')"
			area_name="$(jsonfilter -i "$TEMP_PREFIX.out" -e '@.area_name')"
		fi
	fi
	data_plane_changed=0
	if [ "$old_scope" != "$scope" ] || [ "$old_selected_games" != "$selected_games" ] ||
		[ "$old_target_ip" != "$target_ip" ] || [ "$old_target_id" != "$target_id" ] ||
		[ "$old_area_id" != "$area_id" ] || [ "$old_platform_id" != "$platform_id" ] ||
		[ "$old_acc_mode" != "$acc_mode" ] ||
		[ "$old_openclash_mode" != "$openclash_mode" ]; then
		data_plane_changed=1
	fi
	if [ "$data_plane_changed" -eq 1 ]; then
		invalidate_data_plane
		log_event info config 'Data-plane artifacts invalidated before config change'
	fi

	uci -q set "$CONFIG.main=biubiu_acc"
	uci -q set "$CONFIG.main.schema_version=2"
	uci -q set "$CONFIG.main.scope=$scope"
	uci -q delete "$CONFIG.main.selected_game" 2>/dev/null || true
	for game in $selected_games; do
		uci -q add_list "$CONFIG.main.selected_game=$game" || fail '保存游戏选择失败'
	done
	uci -q set "$CONFIG.main.target_name=$target_name"
	uci -q set "$CONFIG.main.target_ip=$target_ip"
	uci -q set "$CONFIG.main.target_mac=$target_mac"
	uci -q set "$CONFIG.main.target_id=$target_id"
	uci -q set "$CONFIG.main.area_id=$area_id"
	uci -q set "$CONFIG.main.platform_id=$platform_id"
	uci -q set "$CONFIG.main.game_name=$game_name"
	uci -q set "$CONFIG.main.area_name=$area_name"
	uci -q set "$CONFIG.main.acc_mode=$acc_mode"
	uci -q set "$CONFIG.main.log_level=$log_level"
	uci -q set "$CONFIG.main.openclash_mode=$openclash_mode"
	uci -q commit "$CONFIG" || fail '保存配置失败'
	$INIT reload >/dev/null 2>&1 || true
	log_event info config "Saved scope $scope, $game_count game selections, target ${target_ip:-none}"
	emit_message '设备与加速配置已保存'
}

send_sms() {
	local phone area
	phone="$(request_value phone)"
	area="$(request_value area_code)"
	decimal_value "$phone" 20 || fail '手机号必须是数字'
	decimal_value "$area" 4 || fail '区号必须是数字'
	run_cli sms-send sms-send "$phone" "$area" || exit 1
	log_event info account 'SMS login code requested'
	emit_message '验证码已发送'
}

login_sms() {
	local phone area code message
	phone="$(request_value phone)"
	area="$(request_value area_code)"
	code="$(request_value code)"
	decimal_value "$phone" 20 || fail '手机号必须是数字'
	decimal_value "$area" 4 || fail '区号必须是数字'
	decimal_value "$code" 10 || fail '验证码必须是数字'
	[ "$(printf '%s' "$code" | wc -c)" -ge 4 ] || fail '验证码至少 4 位'
	if ! printf '%s\n' "$code" | "$CLI" sms-login-stdin "$phone" "$area" \
		> "$TEMP_PREFIX.out" 2> "$TEMP_PREFIX.err"; then
		code=''
		message="$(tr '\r\n' '  ' < "$TEMP_PREFIX.err" | cut -c 1-240)"
		[ -n "$message" ] || message='登录失败'
		log_event error account "$message"
		printf '%s\n' "$message" >&2
		exit 1
	fi
	code=''
	invalidate_data_plane
	log_event info account 'SMS login completed and session stored'
	emit_message '登录成功，会话已安全保存'
}

refresh_session() {
	run_cli session-refresh session-refresh || exit 1
	invalidate_data_plane
	log_event info account 'Session refreshed'
	emit_message '账号会话已续期'
}

clear_session() {
	run_cli session-clear session-clear || exit 1
	invalidate_data_plane
	log_event info account 'Local session removed'
	emit_message '本地账号会话已清除'
}

import_key() {
	local value source
	value="$(request_value value)"
	safe_text "$value" 8192 || fail '公钥内容无效'
	source="$TEMP_PREFIX.key"
	printf '%s\n' "$value" > "$source"
	chmod 0600 "$source"
	run_cli key-import acc-key-import "$source" || exit 1
	value=''
	log_event info key 'Acceleration public key imported'
	emit_message '加速业务公钥已导入'
}

fetch_key() {
	run_cli key_fetch acc-key-fetch || exit 1
	log_event info key 'Acceleration public key fetch completed'
	emit_message '已从官方配置接口获取并缓存加速业务公钥'
}

self_test() {
	run_cli self-test self-test || exit 1
	log_event info diagnostics 'Offline self-test passed'
	emit_message '本地协议与私有存储自检通过'
}

service_action() {
	local action
	action="$(request_value action)"
	case "$action" in
		start)
			uci -q set "$CONFIG.main.manager_enabled=1"
			uci -q commit "$CONFIG"
			$INIT enable >/dev/null 2>&1 || true
			$INIT restart >/dev/null 2>&1 || fail '管理服务启动失败'
			;;
		stop)
			uci -q set "$CONFIG.main.manager_enabled=0"
			uci -q set "$CONFIG.main.acceleration_enabled=0"
			uci -q commit "$CONFIG"
			$INIT stop >/dev/null 2>&1 || true
			$INIT disable >/dev/null 2>&1 || true
			;;
		restart)
			[ "$(uci_get main manager_enabled 0)" = 1 ] || fail '管理服务尚未启用'
			$INIT restart >/dev/null 2>&1 || fail '管理服务重启失败'
			;;
		*) fail '服务操作无效' ;;
	esac
	log_event info service "$action"
	emit_message '管理服务状态已更新'
}

show_logs() {
	[ -f "$LOG_FILE" ] || return 0
	tail -n 300 "$LOG_FILE"
}

clear_logs() {
	: > "$LOG_FILE"
	chmod 0600 "$LOG_FILE"
	emit_message '日志已清空'
}

handle_request() {
	local operation
	acquire_request
	operation="$(request_value operation)"
	case "$operation" in
		save_config) save_config ;;
		sms_send) send_sms ;;
		sms_login) login_sms ;;
		session_refresh) refresh_session ;;
		session_clear) clear_session ;;
	import_key) import_key ;;
	fetch_key) fetch_key ;;
	self_test) self_test ;;
		game_list) control_game_list ;;
		game_search) control_game_search ;;
		game_options) control_game_options ;;
		check_speedup) control_check_speedup ;;
		profile_fetch) control_profile_fetch ;;
		signal_login) control_signal_login ;;
		channel_renew) control_channel_renew ;;
		runtime_prepare) control_runtime_prepare ;;
		acceleration_action) control_acceleration_action ;;
		service_action) service_action ;;
		clear_logs) clear_logs ;;
		*) fail '不支持的操作' ;;
	esac
}

prepare_dirs

case "${1:-}" in
	snapshot) snapshot ;;
	catalog) show_catalog ;;
	match-status) match_status ;;
	request) handle_request ;;
	logs) show_logs ;;
	*) printf 'Usage: biubiu-acc-manager {snapshot|catalog|match-status|request|logs}\n' >&2; exit 2 ;;
esac
