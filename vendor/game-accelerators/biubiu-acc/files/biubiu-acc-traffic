#!/bin/sh

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

CONFIG='biubiu-acc'
ENGINE='/usr/bin/biubiu-accd'
MANAGER='/usr/libexec/biubiu-acc-manager'
RUNTIME_ROOT='/tmp/biubiu-acc'
RUNTIME_FILE='/etc/biubiu-acc/runtime.json'
PID_FILE="$RUNTIME_ROOT/engine.pid"
STATE_FILE="$RUNTIME_ROOT/traffic.json"
PROXY_STATE_FILE="$RUNTIME_ROOT/proxies.json"
LOG_FILE='/var/log/biubiu-acc/engine.log'
NFT_FAMILY='inet'
NFT_TABLE='biubiu_acc'
MARK='0x6d'
ROUTE_TABLE='107'
TCP_PORT='18080'
UDP_PORT='18081'
MAX_PROFILE_DOMAIN_RULES=128
MAX_PROFILE_RULES=2048
PROXY_WAIT_ATTEMPTS=31

umask 077

valid_ipv4() (
	local octet
	set -f
	IFS=.
	# shellcheck disable=SC2086
	set -- $1
	[ "$#" -eq 4 ] || exit 1
	for octet in "$@"; do
		case "$octet" in ''|*[!0-9]*) exit 1 ;; esac
		[ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] || exit 1
	done
)

valid_cidr() {
	local value address prefix
	value="$1"
	case "$value" in
		''|*[!0-9./]*|*/*/*) return 1 ;;
	esac
	address="${value%/*}"
	prefix="${value#*/}"
	[ "$address" != "$value" ] || return 1
	valid_ipv4 "$address" || return 1
	case "$prefix" in ''|*[!0-9]*) return 1 ;; esac
	[ "$prefix" -le 32 ] 2>/dev/null
}

valid_domain() (
	local value label length old_ifs
	value="$1"
	case "$value" in
		''|.*|*.|*..*|*[!A-Za-z0-9.-]*) exit 1 ;;
	esac
	length="$(printf '%s' "$value" | wc -c)"
	case "$length" in ''|*[!0-9]*) exit 1 ;; esac
	[ "$length" -le 253 ] || exit 1
	old_ifs="$IFS"
	set -f
	IFS=.
	# shellcheck disable=SC2086
	set -- $value
	IFS="$old_ifs"
	[ "$#" -gt 0 ] || exit 1
	for label in "$@"; do
		case "$label" in ''|-*|*-|*[!A-Za-z0-9-]*) exit 1 ;; esac
		length="$(printf '%s' "$label" | wc -c)"
		case "$length" in ''|*[!0-9]*) exit 1 ;; esac
		[ "$length" -le 63 ] || exit 1
	done
)

resolve_domain() {
	local domain="$1"
	if command -v resolveip >/dev/null 2>&1; then
		resolveip -4 "$domain" 2>/dev/null |
			awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+(\.[0-9]+){3}$/) print $i }'
	fi
	if command -v getent >/dev/null 2>&1; then
		getent ahostsv4 "$domain" 2>/dev/null |
			awk '$1 ~ /^[0-9]+(\.[0-9]+){3}$/ { print $1 }'
	fi
	if command -v nslookup >/dev/null 2>&1; then
		nslookup "$domain" 2>/dev/null | awk '
			BEGIN { answer = 0 }
			tolower($0) ~ /^[[:space:]]*name[[:space:]]*:/ { answer = 1; next }
			answer { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+(\.[0-9]+){3}$/) print $i }
		'
	fi
}

collect_domain_ips() {
	local domain="$1" ip ips='' count=0
	for ip in $(resolve_domain "$domain"); do
		valid_ipv4 "$ip" || continue
		case ",$ips," in *",$ip,"*) continue ;; esac
		ips="${ips}${ips:+,}${ip}"
		count=$((count + 1))
		[ "$count" -lt 16 ] || break
	done
	printf '%s\n' "$ips"
}

valid_port_spec() {
	local spec="$1" value low high separator
	[ -n "$spec" ] || return 1
	[ "$spec" = '*' ] && return 0
	case "$spec" in *[!0-9,-]*|,*|*,|*,,*) return 1 ;; esac
	for value in $(printf '%s' "$spec" | tr ',' ' '); do
		separator="${value#*-}"
		if [ "$separator" = "$value" ]; then
			low="$value"
			high="$value"
		else
			case "$value" in *-*-) return 1 ;; esac
			low="${value%%-*}"
			high="${value#*-}"
		fi
		case "$low:$high" in *[!0-9:]*|:*) return 1 ;; esac
		[ "$low" -ge 1 ] 2>/dev/null && [ "$high" -le 65535 ] 2>/dev/null || return 1
		[ "$low" -le "$high" ] 2>/dev/null || return 1
	done
}

config_value() {
	uci -q get "$CONFIG.main.$1" 2>/dev/null || printf '%s\n' "${2:-}"
}

print_selected_game_hint() {
	case "$1" in
		steam|counter-strike-2) printf '%s\n' "$1"; return 0 ;;
		*) return 0 ;;
	esac
}

port_hints() {
	local game
	tcp_ports=''
	udp_ports=''
	config_load "$CONFIG"
	for game in $(config_list_foreach main selected_game print_selected_game_hint); do
		case "$game" in
			steam|counter-strike-2)
				tcp_ports='27015-27050'
				;;
		esac
		case "$game" in
			steam)
				udp_ports='3478,4379-4380,27000-27250'
				;;
			counter-strike-2)
				[ -n "$udp_ports" ] || udp_ports='27000-27250'
				;;
		esac
	done
	[ -n "$tcp_ports$udp_ports" ]
}

profile_rules() {
	local protocol="$1" rules rule cidr ports
	rules="$(jsonfilter -i "$RUNTIME_FILE" -e "@.${protocol}Rules[*]" 2>/dev/null)"
	for rule in $rules; do
		case "$rule" in
			*'|'*)
				cidr="${rule%%|*}"
				ports="${rule#*|}"
				valid_cidr "$cidr" || {
					printf '%s\n' 'runtime contains an invalid provider CIDR rule' >&2
					return 1
				}
				valid_port_spec "$ports" || {
					printf '%s\n' 'runtime contains an invalid provider port rule' >&2
					return 1
				}
				[ "$profile_rule_count" -lt "$MAX_PROFILE_RULES" ] || {
					printf '%s\n' 'runtime contains too many provider rules' >&2
					return 1
				}
				profile_rule_count=$((profile_rule_count + 1))
				profile_rule_specs="${profile_rule_specs}${profile_rule_specs:+
}${protocol}|${cidr}|${ports}"
				;;
			*)
				printf '%s\n' 'runtime contains a malformed provider rule' >&2
				return 1
				;;
		esac
	done
}

profile_domains() {
	local protocol="$1" domains rule domain ports ips domain_index set_name
	domains="$(jsonfilter -i "$RUNTIME_FILE" -e "@.${protocol}Domains[*]" 2>/dev/null)"
	for rule in $domains; do
		case "$rule" in
			*'|'*)
				domain="${rule%%|*}"
				ports="${rule#*|}"
				valid_domain "$domain" || {
					printf '%s\n' 'runtime contains an invalid provider domain rule' >&2
					return 1
				}
				valid_port_spec "$ports" || {
					printf '%s\n' 'runtime contains an invalid provider domain port rule' >&2
					return 1
				}
				[ "$profile_domain_rule_count" -lt "$MAX_PROFILE_DOMAIN_RULES" ] || {
					printf '%s\n' 'runtime contains too many provider domain rules' >&2
					return 1
				}
				domain="$(printf '%s' "$domain" | tr 'A-Z' 'a-z')"
				case "$protocol" in
					tcp)
						tcp_domain_index=$((tcp_domain_index + 1))
						domain_index="$tcp_domain_index"
						;;
					udp)
						udp_domain_index=$((udp_domain_index + 1))
						domain_index="$udp_domain_index"
						;;
					*) return 1 ;;
				esac
				set_name="provider_domain_${protocol}_${domain_index}"
				ips="$(collect_domain_ips "$domain")"
				profile_domain_rule_count=$((profile_domain_rule_count + 1))
				[ -n "$ips" ] && profile_domain_resolved_count=$((profile_domain_resolved_count + 1)) ||
					logger -t biubiu-acc "provider domain unresolved: $domain"
				profile_domain_specs="${profile_domain_specs}${profile_domain_specs:+
}${protocol}|${set_name}|${ports}|${ips}"
				;;
			*)
				printf '%s\n' 'runtime contains a malformed provider domain rule' >&2
				return 1
				;;
		esac
	done
}

refresh_domain_sets() {
	local protocol domains rule domain ports ips domain_index set_name refresh_script=''
	[ "$(id -u)" = 0 ] || return 1
	[ -f "$RUNTIME_FILE" ] && [ ! -L "$RUNTIME_FILE" ] || return 1
	nft list table "$NFT_FAMILY" "$NFT_TABLE" >/dev/null 2>&1 || return 1
	for protocol in tcp udp; do
		domain_index=0
		domains="$(jsonfilter -i "$RUNTIME_FILE" -e "@.${protocol}Domains[*]" 2>/dev/null)"
		for rule in $domains; do
			case "$rule" in
				*'|'*)
					domain="${rule%%|*}"
					ports="${rule#*|}"
					valid_domain "$domain" || return 1
					valid_port_spec "$ports" || return 1
					[ "$domain_index" -lt "$MAX_PROFILE_DOMAIN_RULES" ] || return 1
					domain="$(printf '%s' "$domain" | tr 'A-Z' 'a-z')"
					domain_index=$((domain_index + 1))
					set_name="provider_domain_${protocol}_${domain_index}"
					ips="$(collect_domain_ips "$domain")"
					refresh_script="${refresh_script}
flush set $NFT_FAMILY $NFT_TABLE $set_name
"
					if [ -n "$ips" ]; then
						refresh_script="${refresh_script}add element $NFT_FAMILY $NFT_TABLE $set_name { $ips }
"
					fi
					;;
				*) return 1 ;;
			esac
		done
	done
	[ -n "$refresh_script" ] || return 0
	printf '%s\n' "$refresh_script" | nft -f - >/dev/null 2>&1
}

engine_running() {
	local pid command_line
	[ -r "$PID_FILE" ] || return 1
	pid="$(cat "$PID_FILE" 2>/dev/null)"
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ "$pid" -gt 1 ] || return 1
	[ -r "/proc/$pid/cmdline" ] || return 1
	command_line="$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
	case "$command_line" in *'/usr/bin/biubiu-accd'*) kill -0 "$pid" 2>/dev/null ;; *) return 1 ;; esac
}

write_state() {
	local accelerating="$1" openclash_was_running="$2" message="$3" temp
	temp="$STATE_FILE.$$"
	mkdir -p "$RUNTIME_ROOT"
	chmod 0700 "$RUNTIME_ROOT"
	json_init
	json_add_boolean accelerating "$accelerating"
	json_add_boolean openclash_was_running "$openclash_was_running"
	json_add_string message "$message"
	json_dump > "$temp"
	chmod 0600 "$temp"
	mv -f "$temp" "$STATE_FILE"
}

# Keep the conflict surface deliberately small.  Each init path is fixed here so
# a corrupted runtime state cannot choose an arbitrary command to execute.  The
# process guards deliberately do not require `init running`: OpenClash can run
# outside procd, while its init script still owns normal stop/start cleanup.
proxy_service_running() {
	case "$1" in
		openclash)
			pidof mihomo clash clash_meta >/dev/null 2>&1
			;;
		daed)
			pidof daed daed-guard >/dev/null 2>&1
			;;
		dae)
			pidof dae >/dev/null 2>&1
			;;
		*) return 1 ;;
	esac
}

proxy_wait_tick() {
	sleep 1
}

proxy_wait_for_running() {
	local service="$1" attempts=0
	while [ "$attempts" -lt "$PROXY_WAIT_ATTEMPTS" ]; do
		proxy_service_running "$service" && return 0
		attempts=$((attempts + 1))
		[ "$attempts" -lt "$PROXY_WAIT_ATTEMPTS" ] && proxy_wait_tick
	done
	return 1
}

proxy_wait_for_stopped() {
	local service="$1" attempts=0
	while [ "$attempts" -lt "$PROXY_WAIT_ATTEMPTS" ]; do
		proxy_service_running "$service" || return 0
		attempts=$((attempts + 1))
		[ "$attempts" -lt "$PROXY_WAIT_ATTEMPTS" ] && proxy_wait_tick
	done
	return 1
}

proxy_service_stop() {
	case "$1" in
		openclash) /etc/init.d/openclash stop >/dev/null 2>&1 ;;
		daed) /etc/init.d/daed stop >/dev/null 2>&1 ;;
		dae) /etc/init.d/dae stop >/dev/null 2>&1 ;;
		*) return 1 ;;
	esac
}

proxy_service_start() {
	case "$1" in
		openclash) /etc/init.d/openclash start >/dev/null 2>&1 ;;
		daed) /etc/init.d/daed start >/dev/null 2>&1 ;;
		dae) /etc/init.d/dae start >/dev/null 2>&1 ;;
		*) return 1 ;;
	esac
}

proxy_state_value() {
	local key value
	case "$1:$2" in
		openclash:was_running) key='openclash_was_running' ;;
		openclash:stop_intent) key='openclash_stop_intent' ;;
		openclash:stopped) key='openclash_stopped' ;;
		daed:was_running) key='daed_was_running' ;;
		daed:stop_intent) key='daed_stop_intent' ;;
		daed:stopped) key='daed_stopped' ;;
		dae:was_running) key='dae_was_running' ;;
		dae:stop_intent) key='dae_stop_intent' ;;
		dae:stopped) key='dae_stopped' ;;
		*) return 1 ;;
	esac
	[ -f "$PROXY_STATE_FILE" ] && [ ! -L "$PROXY_STATE_FILE" ] || {
		printf '0\n'
		return 0
	}
	value="$(jsonfilter -i "$PROXY_STATE_FILE" -e "@.$key" 2>/dev/null | head -n 1)"
	case "$value" in 1|true) printf '1\n' ;; *) printf '0\n' ;; esac
}

proxy_state_load() {
	PROXY_OC_WAS="$(proxy_state_value openclash was_running)"
	PROXY_OC_INTENT="$(proxy_state_value openclash stop_intent)"
	PROXY_OC_STOPPED="$(proxy_state_value openclash stopped)"
	PROXY_DAED_WAS="$(proxy_state_value daed was_running)"
	PROXY_DAED_INTENT="$(proxy_state_value daed stop_intent)"
	PROXY_DAED_STOPPED="$(proxy_state_value daed stopped)"
	PROXY_DAE_WAS="$(proxy_state_value dae was_running)"
	PROXY_DAE_INTENT="$(proxy_state_value dae stop_intent)"
	PROXY_DAE_STOPPED="$(proxy_state_value dae stopped)"
}

proxy_state_write() {
	local temp
	[ ! -L "$PROXY_STATE_FILE" ] || return 1
	mkdir -p "$RUNTIME_ROOT" || return 1
	chmod 0700 "$RUNTIME_ROOT" || return 1
	temp="$PROXY_STATE_FILE.$$"
	json_init
	json_add_int version 1
	json_add_boolean openclash_was_running "$PROXY_OC_WAS"
	json_add_boolean openclash_stop_intent "$PROXY_OC_INTENT"
	json_add_boolean openclash_stopped "$PROXY_OC_STOPPED"
	json_add_boolean daed_was_running "$PROXY_DAED_WAS"
	json_add_boolean daed_stop_intent "$PROXY_DAED_INTENT"
	json_add_boolean daed_stopped "$PROXY_DAED_STOPPED"
	json_add_boolean dae_was_running "$PROXY_DAE_WAS"
	json_add_boolean dae_stop_intent "$PROXY_DAE_INTENT"
	json_add_boolean dae_stopped "$PROXY_DAE_STOPPED"
	json_dump > "$temp" || {
		rm -f "$temp"
		return 1
	}
	chmod 0600 "$temp" || {
		rm -f "$temp"
		return 1
	}
	mv -f "$temp" "$PROXY_STATE_FILE"
}

proxy_state_seed_legacy() {
	local was_running
	if [ -e "$PROXY_STATE_FILE" ] || [ -L "$PROXY_STATE_FILE" ]; then
		return 0
	fi
	was_running="$(jsonfilter -i "$STATE_FILE" -e '@.openclash_was_running' 2>/dev/null | head -n 1)"
	case "$was_running" in 1|true) ;; *) return 0 ;; esac
	PROXY_OC_WAS=1
	PROXY_OC_INTENT=0
	PROXY_OC_STOPPED=1
	PROXY_DAED_WAS=0
	PROXY_DAED_INTENT=0
	PROXY_DAED_STOPPED=0
	PROXY_DAE_WAS=0
	PROXY_DAE_INTENT=0
	PROXY_DAE_STOPPED=0
	proxy_state_write
}

proxy_state_mark_stop_intent() {
	proxy_state_load
	case "$1" in
		openclash) PROXY_OC_WAS=1; PROXY_OC_INTENT=1 ;;
		daed) PROXY_DAED_WAS=1; PROXY_DAED_INTENT=1 ;;
		dae) PROXY_DAE_WAS=1; PROXY_DAE_INTENT=1 ;;
		*) return 1 ;;
	esac
	proxy_state_write
}

proxy_state_mark_stopped() {
	proxy_state_load
	case "$1" in
		openclash) PROXY_OC_WAS=1; PROXY_OC_INTENT=0; PROXY_OC_STOPPED=1 ;;
		daed) PROXY_DAED_WAS=1; PROXY_DAED_INTENT=0; PROXY_DAED_STOPPED=1 ;;
		dae) PROXY_DAE_WAS=1; PROXY_DAE_INTENT=0; PROXY_DAE_STOPPED=1 ;;
		*) return 1 ;;
	esac
	proxy_state_write
}

proxy_state_clear_service() {
	proxy_state_load
	case "$1" in
		openclash) PROXY_OC_WAS=0; PROXY_OC_INTENT=0; PROXY_OC_STOPPED=0 ;;
		daed) PROXY_DAED_WAS=0; PROXY_DAED_INTENT=0; PROXY_DAED_STOPPED=0 ;;
		dae) PROXY_DAE_WAS=0; PROXY_DAE_INTENT=0; PROXY_DAE_STOPPED=0 ;;
		*) return 1 ;;
	esac
	proxy_state_write
}

proxy_state_service_stopped() {
	case "$1" in
		openclash) [ "$(proxy_state_value openclash stopped)" = 1 ] ;;
		daed) [ "$(proxy_state_value daed stopped)" = 1 ] ;;
		dae) [ "$(proxy_state_value dae stopped)" = 1 ] ;;
		*) return 1 ;;
	esac
}

proxy_state_has_pending() {
	proxy_state_service_stopped openclash ||
		proxy_state_service_stopped daed ||
		proxy_state_service_stopped dae
}

# An interruption after init stop but before the post-stop write leaves an
# intent.  Reconcile it with the exact service guard before attempting recovery.
proxy_state_reconcile_intents() {
	local changed=0
	proxy_state_load
	if [ "$PROXY_OC_WAS:$PROXY_OC_INTENT:$PROXY_OC_STOPPED" = '1:1:0' ]; then
		if proxy_service_running openclash; then PROXY_OC_INTENT=0; else PROXY_OC_INTENT=0; PROXY_OC_STOPPED=1; fi
		changed=1
	fi
	if [ "$PROXY_DAED_WAS:$PROXY_DAED_INTENT:$PROXY_DAED_STOPPED" = '1:1:0' ]; then
		if proxy_service_running daed; then PROXY_DAED_INTENT=0; else PROXY_DAED_INTENT=0; PROXY_DAED_STOPPED=1; fi
		changed=1
	fi
	if [ "$PROXY_DAE_WAS:$PROXY_DAE_INTENT:$PROXY_DAE_STOPPED" = '1:1:0' ]; then
		if proxy_service_running dae; then PROXY_DAE_INTENT=0; else PROXY_DAE_INTENT=0; PROXY_DAE_STOPPED=1; fi
		changed=1
	fi
	[ "$changed" -eq 0 ] || proxy_state_write
}

proxy_state_openclash_marker() {
	[ "$(proxy_state_value openclash stopped)" = 1 ] && printf '1\n' || printf '0\n'
}

restore_proxy_services() {
	local service failed=0
	for service in "$@"; do
		case "$service" in openclash|daed|dae) ;; *) continue ;; esac
		proxy_state_service_stopped "$service" || continue
		if proxy_service_running "$service"; then
			proxy_state_clear_service "$service" || failed=1
			continue
		fi
		proxy_service_start "$service" || true
		if proxy_wait_for_running "$service"; then
			proxy_state_clear_service "$service" || failed=1
		else
			logger -t biubiu-acc "$service restore failed"
			failed=1
		fi
	done
	if [ "$failed" -eq 0 ] && ! proxy_state_has_pending; then
		rm -f "$PROXY_STATE_FILE"
	fi
	return "$failed"
}

restore_pending_proxies() {
	proxy_state_seed_legacy || return 1
	proxy_state_reconcile_intents || return 1
	restore_proxy_services openclash daed dae || true
	if proxy_state_has_pending; then
		return 1
	fi
	rm -f "$PROXY_STATE_FILE"
}

stop_conflicting_proxies() {
	local mode="$1" service stop_status still_running
	STOPPED_PROXY_SERVICES=''
	proxy_state_seed_legacy || return 1
	for service in openclash daed dae; do
		proxy_service_running "$service" || continue
		[ "$mode" = exclusive ] || {
			printf '%s\n' "$service is running; choose exclusive conflict mode first" >&2
			return 1
		}
		proxy_state_mark_stop_intent "$service" || {
			printf '%s\n' "unable to record $service recovery state" >&2
			restore_proxy_services $STOPPED_PROXY_SERVICES || true
			return 1
		}
		stop_status=0
		proxy_service_stop "$service" || stop_status=1
		if proxy_wait_for_stopped "$service"; then
			still_running=0
			STOPPED_PROXY_SERVICES="${STOPPED_PROXY_SERVICES}${STOPPED_PROXY_SERVICES:+ }$service"
			if ! proxy_state_mark_stopped "$service"; then
				logger -t biubiu-acc "unable to persist $service stop state"
				proxy_state_reconcile_intents || true
				restore_proxy_services $STOPPED_PROXY_SERVICES || true
				return 1
			fi
		else
			still_running=1
		fi
		if [ "$stop_status" -ne 0 ] || [ "$still_running" -eq 1 ]; then
			logger -t biubiu-acc "$service stop failed"
			proxy_state_reconcile_intents || true
			restore_proxy_services $STOPPED_PROXY_SERVICES || true
			return 1
		fi
	done
}

remove_routes() {
	nft delete table "$NFT_FAMILY" "$NFT_TABLE" 2>/dev/null || true
	ip route del local 0.0.0.0/0 dev lo table "$ROUTE_TABLE" 2>/dev/null || true
	ip rule del fwmark "$MARK" table "$ROUTE_TABLE" 2>/dev/null || true
}

stop_engine() {
	local pid attempts
	if [ -r "$PID_FILE" ]; then
		pid="$(cat "$PID_FILE" 2>/dev/null)"
		case "$pid" in ''|*[!0-9]*) pid='' ;; esac
		if [ -n "$pid" ] && engine_running; then
			kill "$pid" 2>/dev/null || true
			attempts=0
			while engine_running && [ "$attempts" -lt 20 ]; do
				attempts=$((attempts + 1))
				usleep 100000 2>/dev/null || sleep 1
			done
			engine_running && kill -9 "$pid" 2>/dev/null || true
		fi
	fi
	rm -f "$PID_FILE"
}

stop_all() {
	stop_engine
	remove_routes
	if ! restore_pending_proxies; then
		write_state 0 "$(proxy_state_openclash_marker)" 'proxy restore failed'
		return 1
	fi
	rm -f "$STATE_FILE"
}

reload_all() {
	# Keep recovery ownership while replacing nft rules and the engine.  A channel
	# renewal must never bring another proxy back before acceleration is ready.
	proxy_state_seed_legacy || return 1
	stop_engine
	remove_routes
	start_all
}

start_all() {
	local scope target_ip openclash_mode selector log_dir
	local nft_script pid rule rule_protocol cidr ports set_name ips

	[ "$(id -u)" = 0 ] || {
		printf '%s\n' 'biubiu traffic control requires root' >&2
		return 1
	}
	[ -x "$ENGINE" ] || {
		printf '%s\n' 'biubiu-accd is not installed' >&2
		return 1
	}
	[ -f "$RUNTIME_FILE" ] && [ ! -L "$RUNTIME_FILE" ] || {
		printf '%s\n' 'authorized runtime.json is missing' >&2
		return 1
	}
	port_hints || true
	profile_rule_count=0
	profile_rule_specs=''
	profile_domain_rule_count=0
	profile_domain_resolved_count=0
	profile_domain_specs=''
	tcp_domain_index=0
	udp_domain_index=0
	profile_rules tcp || return 1
	profile_rules udp || return 1
	profile_domains tcp || return 1
	profile_domains udp || return 1
	[ -n "$tcp_ports$udp_ports" ] || [ "$profile_rule_count" -gt 0 ] ||
	[ "$profile_domain_resolved_count" -gt 0 ] || {
		printf '%s\n' 'selected games have no local or provider route hints' >&2
		return 1
	}
	scope="$(config_value scope lan)"
	target_ip="$(config_value target_ip '')"
	case "$scope" in
		lan) selector='iifname "br-lan"' ;;
		device)
			valid_ipv4 "$target_ip" || {
				printf '%s\n' 'selected device IPv4 address is invalid' >&2
				return 1
			}
			selector="iifname \"br-lan\" ip saddr $target_ip"
			;;
		*) printf '%s\n' 'invalid traffic scope' >&2; return 1 ;;
	esac
	openclash_mode="$(config_value openclash_mode exclusive)"
	stop_conflicting_proxies "$openclash_mode" || return 1
	remove_routes
	if ! ip rule add fwmark "$MARK" table "$ROUTE_TABLE" 2>/dev/null && \
		! ip rule list | grep -Fq "fwmark $MARK"; then
		printf '%s\n' 'unable to install policy rule' >&2
		restore_proxy_services $STOPPED_PROXY_SERVICES || true
		return 1
	fi
	if ! ip route add local 0.0.0.0/0 dev lo table "$ROUTE_TABLE" 2>/dev/null && \
		! ip route show table "$ROUTE_TABLE" | grep -Fq 'local 0.0.0.0/0 dev lo'; then
		remove_routes
		restore_proxy_services $STOPPED_PROXY_SERVICES || true
		printf '%s\n' 'unable to install transparent route' >&2
		return 1
	fi
	nft_script="add table $NFT_FAMILY $NFT_TABLE
add chain $NFT_FAMILY $NFT_TABLE prerouting { type filter hook prerouting priority mangle; policy accept; }"
	while IFS='|' read -r rule_protocol set_name ports ips; do
		[ -n "$rule_protocol" ] || continue
		nft_script="${nft_script}
add set $NFT_FAMILY $NFT_TABLE $set_name { type ipv4_addr; flags timeout; timeout 300s; }"
		if [ -n "$ips" ]; then
			nft_script="${nft_script}
add element $NFT_FAMILY $NFT_TABLE $set_name { $ips }"
		fi
		if [ "$ports" = '*' ]; then
			nft_script="${nft_script}
add rule $NFT_FAMILY $NFT_TABLE prerouting $selector ip daddr @$set_name meta l4proto $rule_protocol tproxy ip to :$( [ "$rule_protocol" = tcp ] && printf '%s' "$TCP_PORT" || printf '%s' "$UDP_PORT" ) meta mark set $MARK accept"
		else
			nft_script="${nft_script}
add rule $NFT_FAMILY $NFT_TABLE prerouting $selector ip daddr @$set_name $rule_protocol dport { $ports } tproxy ip to :$( [ "$rule_protocol" = tcp ] && printf '%s' "$TCP_PORT" || printf '%s' "$UDP_PORT" ) meta mark set $MARK accept"
		fi
	done <<EOF
$profile_domain_specs
EOF
	if [ -n "$tcp_ports" ]; then
		nft_script="${nft_script}
add rule $NFT_FAMILY $NFT_TABLE prerouting $selector tcp dport { $tcp_ports } tproxy ip to :$TCP_PORT meta mark set $MARK accept"
	fi
	if [ -n "$udp_ports" ]; then
		nft_script="${nft_script}
add rule $NFT_FAMILY $NFT_TABLE prerouting $selector udp dport { $udp_ports } tproxy ip to :$UDP_PORT meta mark set $MARK accept"
	fi
	while IFS='|' read -r rule_protocol cidr ports; do
		[ -n "$rule_protocol" ] || continue
		if [ "$ports" = '*' ]; then
			nft_script="${nft_script}
add rule $NFT_FAMILY $NFT_TABLE prerouting $selector ip daddr $cidr meta l4proto $rule_protocol tproxy ip to :$( [ "$rule_protocol" = tcp ] && printf '%s' "$TCP_PORT" || printf '%s' "$UDP_PORT" ) meta mark set $MARK accept"
		else
			nft_script="${nft_script}
add rule $NFT_FAMILY $NFT_TABLE prerouting $selector ip daddr $cidr $rule_protocol dport { $ports } tproxy ip to :$( [ "$rule_protocol" = tcp ] && printf '%s' "$TCP_PORT" || printf '%s' "$UDP_PORT" ) meta mark set $MARK accept"
		fi
	done <<EOF
$profile_rule_specs
EOF
	if ! printf '%s\n' "$nft_script" | nft -f - >/dev/null 2>&1; then
		remove_routes
		restore_proxy_services $STOPPED_PROXY_SERVICES || true
		printf '%s\n' 'unable to install nftables transparent rules' >&2
		return 1
	fi
	log_dir="${LOG_FILE%/*}"
	mkdir -p "$RUNTIME_ROOT" "$log_dir"
	chmod 0700 "$RUNTIME_ROOT" "$log_dir"
	: > "$LOG_FILE"
	chmod 0600 "$LOG_FILE"
	"$ENGINE" --runtime "$RUNTIME_FILE" --tcp-port "$TCP_PORT" --udp-port "$UDP_PORT" \
		>> "$LOG_FILE" 2>&1 &
	pid=$!
	printf '%s\n' "$pid" > "$PID_FILE"
	chmod 0600 "$PID_FILE"
	sleep 1
	if ! kill -0 "$pid" 2>/dev/null; then
		stop_engine
		remove_routes
		restore_proxy_services $STOPPED_PROXY_SERVICES || true
		printf '%s\n' 'biubiu-accd failed to start; see engine.log' >&2
		return 1
	fi
	write_state 1 "$(proxy_state_openclash_marker)" 'running'
}

case "${1:-}" in
	start)
		proxy_state_seed_legacy || exit 1
		stop_engine
		remove_routes
		start_all || {
			write_state 0 "$(proxy_state_openclash_marker)" 'start failed'
			exit 1
		}
		;;
	stop)
		stop_all
		;;
	reload)
		reload_all || {
			write_state 0 "$(proxy_state_openclash_marker)" 'reload failed'
			exit 1
		}
		;;
	refresh)
		refresh_domain_sets
		;;
	status)
		message='' pid=''
		message="$(jsonfilter -i "$STATE_FILE" -e '@.message' 2>/dev/null | head -n 1)"
		pid="$(cat "$PID_FILE" 2>/dev/null)"
		if engine_running; then
			json_init
			json_add_boolean accelerating 1
			json_add_int pid "$pid"
			json_add_string message "$message"
			json_dump
		else
			json_init
			json_add_boolean accelerating 0
			json_add_string message "$message"
			json_dump
		fi
		;;
	*)
		printf 'Usage: biubiu-acc-traffic {start|stop|reload|refresh|status}\n' >&2
		exit 2
		;;
esac
